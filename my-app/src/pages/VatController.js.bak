  // MARKER_OVER_PERIOD_AUTO_V1 -- Auto Over: ถ้า Toggle ปิดอยู่ แต่ Tax Invoice Date เป็นเดือนหลัง Period ปัจจุบัน -> ระบบถือเป็น Over ให้เฉพาะรายการนี้ (Toggle เปิดอยู่ = Toggle เป็นใหญ่ ไม่ดูวันที่)
  const quickActionAutoOverRef = React.useRef(false);
