  const applyQuickActionGrn = (row, currentPeriodMonth) => {
    const grtControl = row?.['VAT GRT Control'] || 'Auto';
    const digitRaw = String(row?.vat_digit || '4DG').toUpperCase().replace(/[^0-9]/g, '');
    const digitCount = (parseInt(digitRaw, 10) >= 1 && parseInt(digitRaw, 10) <= 10) ? parseInt(digitRaw, 10) : 4;
    const manualOver = vatOverOn(row);
    const autoOver = !manualOver && quickActionAutoOverRef.current; // MARKER_OVER_PERIOD_AUTO_V1
    const over = manualOver || autoOver;
    const prefixMonth = manualOver ? getGrnPrefixMonth(row, currentPeriodMonth) : (autoOver ? vatShiftYm(getEffectivePeriodMonth(row, currentPeriodMonth), 1) : getEffectivePeriodMonth(row, currentPeriodMonth));
    const refDate = prefixMonth ? new Date(prefixMonth + '-01') : new Date();
    const prefix = (row?.vat_grn_pattern || '').replace('Y', String(refDate.getFullYear()).slice(-1)).replace('MM', String(refDate.getMonth() + 1).padStart(2, '0'));
    quickActionOverRef.current = over; quickActionBuRowRef.current = row; quickActionPeriodRefRef.current = currentPeriodMonth;
    setQuickActionOver(manualOver);
    setQuickActionVatGrnOverride(null);
    setQuickActionGrtControl(grtControl);
    setQuickActionGrtPrefix(prefix);
    setQuickActionGrtDigitCount(digitCount);
    setQuickActionGrtRunning(grtControl === 'Manual' ? '' : String((parseInt(row?.[over ? 'vat_grn_ov' : 'vat_grn'], 10) || 0) + 1).padStart(digitCount, '0'));
  };
