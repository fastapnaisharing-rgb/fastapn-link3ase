  ];
const POPVAT_BKVIEW_COLUMNS = [ // MARKER_VATWATCHLISTOPS_DRAFT_MONITOR_POPVAT_TABLE_V1 -- Column ตามไฟล์ Popvat จริง (A-I)
    { key: 'branch', label: 'Branch' },
