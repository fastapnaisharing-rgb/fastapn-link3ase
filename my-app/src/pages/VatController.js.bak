      await apiFetch(`/company_list/${bu.id}`, { method: 'PUT', body: JSON.stringify({ vat_over_period: next }) });
      const fr = await apiFetch(`/company_list/${bu.id}`);
      applyQuickActionGrn({ ...(quickActionBuRowRef.current || bu), ...fr }, quickActionPeriodRefRef.current);
      broadcastWs('vat_over_updated', { bu: bu.bu, over: next });
      broadcastWs('company_list_updated', { bu: bu.bu });
