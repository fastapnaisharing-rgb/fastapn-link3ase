      setAddTaxInvoiceGrtNumber(String(nextFromBroadcastFP).padStart(addTaxInvoiceGrtDigitCount, '0'));
      addTaxInvoiceLastUsedGrtRunningRef.current = null; // MARKER_VATWATCHLISTOPS_ADDTAX_GRN_SYNC_BROADCAST_V1 -- DB Sync ล่าสุดแล้ว เคลียร์ค่าที่ยังไม่ได้เขียนกลับทิ้ง (ถ้ามี)
    });
    return unsubscribe;
  }, [bu?.bu, addTaxInvoiceGrtDigitCount]);
  const handleClearTypeRows = async (rowsArg) => { // MARKER_VATWATCHLISTOPS_TYPE_ABF_STATUS_V1 -- Clear: คืน Type A/B/F เป็น Pending + ลบ Note A/B/F ของรายการนั้น
    const targets = (Array.isArray(rowsArg) ? rowsArg : Array.from(selectedNoteRows.values())).filter((r) => /^type_[abf]$/.test(r.status)); // MARKER_VATWATCHLISTOPS_TYPE_ABF_V3
    if (targets.length === 0) return;
