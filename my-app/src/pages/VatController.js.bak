  '{BU_Code}': { kind: 'cfg', label: 'BU (แท็บ เงื่อนไข)', src: 'BU ที่เลือกในแท็บ เงื่อนไข ของ Config นี้', ex: 'REV' },
  '{ชื่อผู้รับ}': { kind: 'cfg', label: 'ชื่อผู้รับ', src: 'ช่อง ชื่อผู้รับ ใน Config นี้ (เมลส่งให้ BU) -- เมลส่งให้ Supplier ใช้ {Sup_Greeting} แทน', ex: 'พี่ตู่' },
