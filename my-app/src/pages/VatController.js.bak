    const popTypeFP = tivItemsFP.some((it) => it.simType === 'NNN') ? 'NNN' : 'YNY'; // Popvat Cancel ต่อ Invoice: ถ้ามีใบกำกับใดเป็น NNN ถือเป็น NNN
