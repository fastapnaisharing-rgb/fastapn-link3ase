    if (groups.size > 1) {
      await confirmDialog.alert('รายการที่เลือกมีทั้งประเภท Asset (Prefix T/F) และ Expense ปนกัน กรุณาแยกทำคนละครั้ง', { title: 'ประเภทภาษีไม่ตรงกัน', variant: 'danger' });
