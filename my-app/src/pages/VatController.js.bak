    const reportDoneFP = []; // เปลี่ยนแล้ว (เก็บสถานะเดิมไว้ Revert)
    const noteWrittenFP = []; // MARKER_VATWATCHLISTOPS_QA_GLTRANSFER_ACCEPT_REMARK_V1 -- Note ที่สร้างใหม่ในรอบนี้ (ลบทิ้งถ้า Error)
    try {
