  const [qaCancelMenuOpen, setQaCancelMenuOpen] = React.useState(false); // MARKER_VATWATCHLISTOPS_QA_GLTRANSFER_V1 -- เมนูลอยของปุ่ม Cancel: Netting-Zero / GL-Transfer
