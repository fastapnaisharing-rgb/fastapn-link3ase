  const [qaPopBOpen, setQaPopBOpen] = React.useState(false); // MARKER_VATWATCHLISTOPS_QA_POPVAT_PARTUSED_V1 -- Modal B - Part Used (วันที่/เดือน/จำนวนเงินที่ใช้ไปแล้ว -> ระบบรวมเป็น match_remark)
