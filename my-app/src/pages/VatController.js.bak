      if (qaGlTotals.dg < -1 || qaGlTotals.dv < -1) { await confirmDialog.alert('ยอดใบกำกับเกิน Invoice — Accept With Remark ใช้ได้เฉพาะกรณีบันทึกขาดเท่านั้น', { title: 'ยอดเกิน Invoice', variant: 'danger' }); return; }
    }
