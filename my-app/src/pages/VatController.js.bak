    const ym = /^\d{4}-\d{2}/.test(String(quickActionTaxInvoiceDate || '')) ? String(quickActionTaxInvoiceDate).slice(0, 7) : '';
    const auto = !quickActionOver && !!ym && !!quickActionPeriodMonth && ym > quickActionPeriodMonth;
    if (auto === quickActionAutoOverRef.current) return;
    quickActionAutoOverRef.current = auto; setQuickActionAutoOver(auto);
    if (showQuickAction && quickActionBuRowRef.current) applyQuickActionGrn(quickActionBuRowRef.current, quickActionPeriodRefRef.current);
  }, [quickActionTaxInvoiceDate, quickActionPeriodMonth, quickActionOver, showQuickAction]);
  const handleToggleQuickActionOver = async () => { // MARKER_VATWATCHLISTOPS_OVER_PERIOD_GRN_V1 -- สับท่อ GRN: ON = เดือนถัดไป (vat_grn_ov) / OFF = ปกติ (vat_grn)
    if (!bu?.id || quickActionOverBusy) return;
    const next = !quickActionOver;
    // MARKER_OVER_TOGGLE_NO_CONFIRM_V1 -- สลับ Over Period ได้ทันที ไม่ถามยืนยัน
    setQuickActionOverBusy(true);
