      await confirmDialog.alert(`สลับ Over Period ไม่สำเร็จ: ${err?.message || err}`, { title: 'Over Period', variant: 'danger' });
    } finally { setQuickActionOverBusy(false); }
  };
  const commitQuickActionGrtRunning = async () => { // MARKER_QA_GRT_OWNER_EDIT_V1 -- Owner ปรับเลข Running -> Confirm -> เขียนกลับ DB (เลขล่าสุดที่ใช้ = เลขที่ตั้ง - 1) -> Broadcast ให้ Session อื่น Sync
    if (!bu?.id) return;
    const key = quickActionOverRef.current ? 'vat_grn_ov' : 'vat_grn';
    const base = quickActionBuRowRef.current || bu;
    const cur = (parseInt(base?.[key], 10) || 0) + 1;
    const padTo = (n) => String(n).padStart(quickActionGrtDigitCount, '0');
    const n = parseInt(quickActionGrtRunning, 10);
    if (!(n >= 1) || n === cur) { setQuickActionGrtRunning(padTo(cur)); return; }
    const ok = await confirmDialog.confirm(
      `ปรับเลข GRN ถัดไปของ ${bu.bu} (${quickActionOverRef.current ? 'ท่อเดือนถัดไป / Over' : 'ท่อปกติ'}) จาก ${padTo(cur)} เป็น ${padTo(n)}?\n\nระบบจะบันทึกลง Database ทันที (เลข GRN ล่าสุดที่ใช้ = ${padTo(n - 1)})` + (n < cur ? '\n\n⚠ เป็นการลดเลขลง อาจซ้ำกับเลขที่เคยใช้ไปแล้ว' : ''),
      { title: 'ปรับเลข GRN', variant: n < cur ? 'danger' : undefined }
    );
    if (!ok) { setQuickActionGrtRunning(padTo(cur)); return; }
    try {
      await apiFetch(`/company_list/${bu.id}`, { method: 'PUT', body: JSON.stringify({ [key]: n - 1 }) });
      quickActionBuRowRef.current = { ...base, [key]: n - 1 };
      setQuickActionGrtRunning(padTo(n));
      broadcastWs('vat_grn_updated', { bu: bu?.bu, vat_grn: n - 1, over: quickActionOverRef.current });
      broadcastWs('company_list_updated', { bu: bu?.bu });
    } catch (err) {
      setQuickActionGrtRunning(padTo(cur));
      await confirmDialog.alert(`ปรับเลข GRN ไม่สำเร็จ: ${err?.message || err}`, { title: 'ปรับเลข GRN', variant: 'danger' });
    }
  };
  React.useEffect(() => { // MARKER_VATWATCHLISTOPS_OVER_PERIOD_GRN_V1 -- Session อื่นสลับ Over Period -> Sync Prefix/Running ที่ Quick Action ทันที
    const unsubscribe = subscribeWs(['vat_over_updated'], async (_wsEvent, payload) => {
