        try { const fr = bu?.id ? await apiFetch(`/company_list/${bu.id}`) : null; if (fr && fr.id) buNow = { ...bu, ...fr }; } catch (_) { /* ใช้ bu เดิม */ }
        const grtControl = buNow?.['VAT GRT Control'] || 'Auto';
        const pattern = buNow?.vat_grn_pattern || '';
        const digitRaw = String(buNow?.vat_digit || '4DG').toUpperCase().replace(/[^0-9]/g, '');
        const digitCount = (parseInt(digitRaw, 10) >= 1 && parseInt(digitRaw, 10) <= 10) ? parseInt(digitRaw, 10) : 4;
        const manualOverNow = vatOverOn(buNow); addTaxManualOverRef.current = manualOverNow; addTaxPeriodRef.current = getEffectivePeriodMonth(buNow, currentPeriodMonth);
        const overNow = manualOverNow || addTaxAutoOverRef.current; // MARKER_OVER_PERIOD_AUTO_V1
        const prefixMonth = manualOverNow ? getGrnPrefixMonth(buNow, currentPeriodMonth) : (overNow ? vatShiftYm(getEffectivePeriodMonth(buNow, currentPeriodMonth), 1) : getEffectivePeriodMonth(buNow, currentPeriodMonth));
        const refDate = prefixMonth ? new Date(prefixMonth + '-01') : new Date();
        const yLast = String(refDate.getFullYear()).slice(-1);
        const mm = String(refDate.getMonth() + 1).padStart(2, '0');
        const prefix = pattern.replace('Y', yLast).replace('MM', mm);
        const nextRunning = (parseInt(buNow?.[overNow ? 'vat_grn_ov' : 'vat_grn'], 10) || 0) + 1;
        addTaxInvoiceOverRef.current = overNow;
        setAddTaxInvoiceOver(overNow);
        setAddTaxInvoiceGrtControl(grtControl);
        setAddTaxInvoiceGrtPrefix(prefix);
        setAddTaxInvoiceGrtDigitCount(digitCount);
        setAddTaxInvoiceGrtNumber(grtControl === 'Manual' ? '' : String(nextRunning).padStart(digitCount, '0'));
