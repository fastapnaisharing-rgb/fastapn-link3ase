                  const r = res.rows[i]; const tk = [r[1], r[5], fmtInt(r[2]), fmtInt(r[3]), fmtAmt(it.recAmount), r[4].replace(/\./g, '/')];
                  return (
                    <div key={i} ref={(el) => { cardRef.current[i] = el; }} onClick={() => pick(i, 'left')} style={{ marginBottom: 14, padding: 8, borderRadius: 10, background: '#fff', border: sel === i ? `2px solid ${NAVY}` : '2px solid transparent', boxShadow: '0 1px 4px rgba(0,0,0,.08)', cursor: 'pointer' }}>
                      <PageCanvas doc={res.doc} pageNo={it.formPage} tokens={tk} title="ฟอร์ม ภ.พ.36" zoom={zoom} />
                      {it.recPage ? <PageCanvas doc={res.doc} pageNo={it.recPage} tokens={tk} title="ใบเสร็จรับเงิน" zoom={zoom} /> : <div style={{ padding: 10, color: '#b26a00', fontSize: 12 }}>⚠ ไม่พบหน้าใบเสร็จของชุดนี้</div>}
                    </div>
                  );
                })}
              </div>
            </div>
            <div style={{ border: '1px solid #e3e8ef', borderRadius: 12, display: 'flex', flexDirection: 'column', minHeight: 0, overflow: 'hidden' }}>
              <div style={{ padding: '8px 12px', background: '#f6f8fb', borderBottom: '1px solid #e3e8ef', fontWeight: 600, color: NAVY, fontSize: 13 }}>ข้อมูลที่ดึงมา · ชุดที่ {sel + 1} / {rows.length} <span style={{ fontWeight: 400, color: '#6b7280', fontSize: 12 }}>แก้ไขได้</span></div>
              <div style={{ flex: 1, overflow: 'auto', padding: 14, scrollbarWidth: 'thin', scrollbarColor: '#b6c0cc transparent' }}>
                {(() => { // MARKER_T36_PDF_SET_FORM_V1 -- แสดงข้อมูลเป็นชุด (ฟอร์มทีละใบ) ไม่ใช่ตารางรวม
                  const i = sel; const r = rows[i]; const it = res.items[i];
                  if (!r) return <div style={{ color: '#6b7280' }}>ชุดนี้ถูกลบออกแล้ว</div>;
                  const lock = !!done[i];
                  const F = [[1, 'ชื่อบริษัทที่โอนต่างประเทศ', 'จากฟอร์ม · ชื่อผู้ประกอบการซึ่งเป็นผู้รับเงิน'], [2, 'มูลค่าฐานภาษี', 'จากฟอร์ม · ข้อ 1 จำนวนเงินที่จ่าย'], [3, 'ภ.พ.36 (ภาษีมูลค่าเพิ่มที่ต้องนำส่ง)', 'จากฟอร์ม · ข้อ 2 (ไม่รวมเงินเพิ่ม/เบี้ยปรับ)'], [4, 'วัน/เดือน/ปี ใบเสร็จรับเงิน', 'จากใบเสร็จ · วันชำระเงิน'], [5, 'เลขที่ใบเสร็จรับเงิน', 'จากฟอร์ม + ใบเสร็จ (ใช้จับคู่)'], [6, 'สาขา Oracle', 'Lookup Branch List จาก Tax ID + สาขาผู้นำส่ง']];
                  return (
                    <div>
                      {F.map(([ci, lb, src]) => (
                        <div key={ci} style={{ marginBottom: 12 }}>
                          <div style={{ fontSize: 12, fontWeight: 600, color: NAVY }}>{lb} <span style={{ fontWeight: 400, color: '#9aa3af', fontSize: 11 }}>· {src}</span></div>
                          <input value={ci === 2 || ci === 3 ? commaLive(r[ci]) : r[ci]} disabled={lock} onChange={(e) => setCell(i, ci, ci === 2 || ci === 3 ? e.target.value.replace(/,/g, '') : e.target.value)} style={{ width: '100%', boxSizing: 'border-box', height: 36, fontSize: 15, padding: '0 10px', border: '1px solid #cfd6e0', borderRadius: 8, background: lock ? '#f3f4f6' : '#fff', textAlign: ci === 2 || ci === 3 ? 'right' : 'left', fontVariantNumeric: 'tabular-nums' }} />
                        </div>
                      ))}
                      <div style={{ padding: '10px 12px', borderRadius: 8, background: it.ok ? '#e8f5e9' : '#fff3d6', color: it.ok ? '#2e7d32' : '#b26a00', fontSize: 13, fontWeight: 600, marginBottom: 12 }}>
                        {it.ok ? `✓ ตรงใบเสร็จ (ยอดใบเสร็จ ${fmtAmt(it.recAmount)})` : `⚠ ${it.issues.join(' ; ')}`}
                        {it.extra && parseFloat(it.extra) > 0 && <div style={{ fontWeight: 400, marginTop: 2 }}>มีเงินเพิ่ม {fmtAmt(it.extra)} — ไม่รวมในช่อง ภ.พ.36</div>}
                      </div>
                      {lock ? <div style={{ padding: 10, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 12, color: done[i] === 'ok' ? '#2e7d32' : '#6b7280', fontWeight: 700 }}><span>{done[i] === 'ok' ? '✓ Confirm แล้ว — เก็บเป็น Draft แล้ว' : 'ข้ามแล้ว'}</span><button type="button" onClick={() => undoOne(i)} style={{ height: 30, borderRadius: 8, border: '1px solid #cfd6e0', background: '#fff', padding: '0 12px', cursor: 'pointer', fontWeight: 600 }}>{done[i] === 'ok' ? 'Cancel' : '↩ เอากลับมาตรวจ'}</button></div> : (
                        <div style={{ display: 'flex', gap: 8 }}>
                          <button type="button" onClick={() => confirmOne(i)} disabled={busy} style={{ opacity: busy ? 0.6 : 1, flex: 1, height: 42, borderRadius: 10, border: `1px solid ${NAVY}`, background: NAVY, color: '#fff', fontSize: 15, fontWeight: 700, cursor: 'pointer' }}>{busy ? 'กำลังบันทึก…' : '✓ Confirm ชุดนี้'}</button>
                          <button type="button" onClick={() => skipOne(i)} style={{ height: 42, borderRadius: 10, border: '1px solid #cfd6e0', background: '#fff', padding: '0 16px', cursor: 'pointer' }}>ข้าม</button>
                        </div>)}
                    </div>
                  );
                })()}
              </div>
              <div style={{ padding: '8px 12px', borderTop: '1px solid #e3e8ef', background: '#fafbfc', color: '#6b7280', fontSize: 12 }}>{saveErr ? <span style={{ color: '#e5484d', fontWeight: 600 }}>{saveErr}</span> : 'Confirm ชุดนี้ = เก็บเป็น Draft ใน DB (ทุกคน/ทุกเครื่องเห็น) + ใส่ตาราง T36 แล้วไปชุดถัดไป · พอ Confirm เข้า Draft จริงค่อยลบ Draft ให้ · การตรวจซ้ำ/ไม่ผ่านใช้กติกา T36 เดิมในตาราง'}</div>
            </div>
          </div>
        )}
        {res && tab === 'list' && (
          <div style={{ flex: 1, overflow: 'auto', padding: 14, scrollbarWidth: 'thin', scrollbarColor: '#b6c0cc transparent' }}>
            <div style={{ fontWeight: 600, color: NAVY, marginBottom: 8 }}>Confirm List <span style={{ fontWeight: 400, color: '#6b7280', fontSize: 12 }}>ชุดที่ Confirm แล้ว (เก็บเป็น Draft แล้ว) · {nDone} ชุด · ข้าม {Object.values(done).filter((v) => v === 'skip').length} ชุด · รอตรวจ {rows.filter((r, i) => r && !done[i]).length} ชุด</span></div>
            {nDone === 0 ? <div style={{ padding: 40, textAlign: 'center', color: '#6b7280' }}>ยังไม่มีชุดที่ Confirm — ไปที่แท็บ Preview แล้วกด Confirm ทีละชุด</div> : (
              <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 13 }}>
                <thead><tr>{['ชุดที่', 'ชื่อบริษัทที่โอนต่างประเทศ', 'มูลค่าฐานภาษี', 'ภ.พ.36', 'วัน/เดือน/ปี ใบเสร็จ', 'เลขที่ใบเสร็จรับเงิน', 'สาขา Oracle', 'เทียบใบเสร็จ', ''].map((h, k) => <th key={k} style={{ background: NAVY, color: '#fff', fontWeight: 500, fontSize: 12, padding: '8px 10px', textAlign: k === 2 || k === 3 ? 'right' : 'left', whiteSpace: 'nowrap', position: 'sticky', top: 0 }}>{h}</th>)}</tr></thead>
                <tbody>
                  {rows.map((r, i) => { if (!r || done[i] !== 'ok') return null; const it = res.items[i]; const td = { padding: '7px 10px', borderBottom: '1px solid #f0eee8', whiteSpace: 'nowrap' };
                    return (
                      <tr key={i}>
                        <td style={td}>{i + 1}</td><td style={td}>{r[1]}</td><td style={{ ...td, textAlign: 'right' }}>{r[2]}</td><td style={{ ...td, textAlign: 'right' }}>{r[3]}</td><td style={td}>{r[4]}</td><td style={td}>{r[5]}</td><td style={td}>{r[6] || <span style={{ color: '#b26a00' }}>— (ใช้ BU)</span>}</td>
                        <td style={{ ...td, color: it.ok ? '#2e7d32' : '#b26a00', fontWeight: 600 }}>{it.ok ? '✓ ตรงใบเสร็จ' : '⚠ ' + it.issues.join(' ; ')}</td>
                        <td style={td}><button type="button" onClick={() => { setTab('preview'); pick(i, 'right'); }} style={{ height: 24, borderRadius: 6, border: '1px solid #cfd6e0', background: '#fff', padding: '0 10px', cursor: 'pointer', fontSize: 12 }}>ดูชุดนี้</button> <button type="button" onClick={() => undoOne(i)} style={{ height: 24, borderRadius: 6, border: '1px solid #cfd6e0', background: '#fff', padding: '0 10px', cursor: 'pointer', fontSize: 12 }}>Cancel</button></td>
                      </tr>); })}
                </tbody>
              </table>)}
          </div>
        )}
      </div>
    </div>
  );
}
