export const SP_HANDLER_RELEASED_AT = "2026-10-18T09:10:00Z"; // วัน-เวลาที่ปล่อยเวอร์ชันนี้ (UTC) -- แก้ทุกครั้งที่ขึ้นเวอร์ชัน (ใช้นับ 7 วันแจ้งเตือน)
export const SP_HANDLER_FILES = {
  "fastapn-sp.ps1": "",
  "setup-fastapn-sp.ps1": "",
  "setup-fastapn-sp.bat": "QGVjaG8gb2ZmDQpjZCAvZCAiJX5kcDAiDQpwb3dlcnNoZWxsLmV4ZSAtTm9Mb2dvIC1Ob1Byb2ZpbGUgLUV4ZWN1dGlvblBvbGljeSBCeXBhc3MgLUZpbGUgIiV+ZHAwc2V0dXAtZmFzdGFwbi1zcC5wczEiICUqDQppZiAvaSBub3QgIiV+MSI9PSItU2lsZW50IiBwYXVzZQ0K",
  "fastapn-run-hidden.vbs": "",
