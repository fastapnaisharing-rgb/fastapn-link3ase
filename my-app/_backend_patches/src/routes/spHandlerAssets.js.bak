// MARKER_SP_HANDLER_VERSION_FROM_FILE_V1 -- เลขเวอร์ชันอ่านจาก $HandlerVersion ใน fastapn-sp.ps1 ที่ฝังอยู่จริง (ไม่พิมพ์เลขเอง)
export const SP_HANDLER_VERSION = (() => { try { const m = Buffer.from(SP_HANDLER_FILES["fastapn-sp.ps1"], "base64").toString("utf8").match(/\$HandlerVersion\s*=\s*(\d+)/); return m ? Number(m[1]) : 0; } catch (e) { return 0; } })();
