const SERVER_START = Date.now();

// ── คำนวณ CPU % ปัจจุบันของทั้งเครื่อง ── MARKER_SYNC_GETCURRENTCPU_APP_V1 ──
// getCurrentCpu() ย้ายไปอยู่ที่ System.js เพียงจุดเดียว (import ด้านบน)
// เดิมมีฟังก์ชันนี้ซ้ำกัน 2 ชุด (คนละ Cache) ทำให้ /health (Deploy Monitor)
// กับ /api/system/cpu-current (CPU Dashboard) รายงานค่า CPU ไม่ตรงกัน

// ── cache git info ตอน startup ครั้งเดียว ────────────────────────────────
let gitInfo = { commit: null, branch: null, author: null, message: null };
try {
  gitInfo.commit  = execSync("git -C D:/fastapn-link3ase/my-app rev-parse --short HEAD",      { timeout: 3000 }).toString().trim();
  gitInfo.branch  = execSync("git -C D:/fastapn-link3ase/my-app rev-parse --abbrev-ref HEAD", { timeout: 3000 }).toString().trim();
  gitInfo.author  = execSync("git -C D:/fastapn-link3ase/my-app log -1 --format=%an",         { timeout: 3000 }).toString().trim();
  gitInfo.message = execSync("git -C D:/fastapn-link3ase/my-app log -1 --format=%s",          { timeout: 3000 }).toString().trim();
} catch {}

app.get("/health", async (req, res) => {
  try {
    const totalMem = os.totalmem();
    const freeMem  = os.freemem();
    const usedMem  = totalMem - freeMem;
    const ramPct   = Math.round((usedMem / totalMem) * 100);

    let dbLatency = null;
    let dbStatus  = "error";
    try {
      const t0 = Date.now();
      await pool.query("SELECT 1");
      dbLatency = Date.now() - t0;
      dbStatus  = "ok";
    } catch {}

    res.json({
      status: "ok",
      uptime: Math.round((Date.now() - SERVER_START) / 1000),
      startedAt: new Date(SERVER_START).toISOString(), // MARKER_HEALTH_STARTEDAT_V1 -- เวลา Restart ล่าสุดจริง ให้ Frontend เทียบ Sync กับ Build Time
      ram: { pct: ramPct, used: Math.round(usedMem / 1024 / 1024), total: Math.round(totalMem / 1024 / 1024) },
      cpu: { pct: await getCurrentCpu() }, // MARKER_FIX_GETCURRENTCPU_ASYNC_APP
      db:  { status: dbStatus, latency: dbLatency },
      git: gitInfo,
    });
  } catch (err) {
    res.status(500).json({ status: "error", error: err.message });
  }
});

