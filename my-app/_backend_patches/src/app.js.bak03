}

// MARKER_BATCH_LIST_15DAY_RETENTION_V1
// MARKER_FIX_RECYCLE_BIN_SCHEMA_V1
// -- Phase 4: ?? batch_list ??????? 15 ??? (?????? created_at) ------------
// -- ???????? recycle_bin ???????? (Soft Delete Pattern ????????????????) --
// -- ?????? bucket_list (Invoice History) ??? � ???? Backup ???????????? --
// -- Batch Comments (Chat) Retention ----------------------------------
// -- ??????? Batch ???? Approve ???? ??? approved_at ???? 7 ??? ---------
// -- ?????? approved_at ??????????? batch_list ??? (Single Source) -----
// -- Batch ????????? Approve (Rejected/???? Processing) ????????????? ----
async function checkAndCleanupBatchComments() {
  const { rows: expired } = await pool.query(
    `SELECT DISTINCT bc.batch_id FROM batch_comments bc
     JOIN batch_list bl ON bl.batch_id = bc.batch_id
     WHERE bl.status = 'approved'
       AND bl.approved_at IS NOT NULL
       AND bl.approved_at < NOW() - INTERVAL '7 days'`
  );

  for (const row of expired) {
    const dir = path.join(CHAT_STORAGE_ROOT, String(row.batch_id));
    if (fs.existsSync(dir)) {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  }

  if (expired.length) {
    await pool.query(
      `DELETE FROM batch_comments
       USING batch_list
       WHERE batch_comments.batch_id = batch_list.batch_id
         AND batch_list.status = 'approved'
         AND batch_list.approved_at < NOW() - INTERVAL '7 days'`
    );
  }
}

async function checkAndCleanupBatchList() {
  await pool.query(
    `WITH moved AS (
       DELETE FROM batch_list
       -- MARKER_BATCHLIST_RETENTION_APPROVED_AT_V1
       WHERE approved_at IS NOT NULL
         AND approved_at < NOW() - INTERVAL '15 days'
       RETURNING *
     )
     INSERT INTO recycle_bin (source_table, source_id, source_key, data, deleted_by, deleted_at)
     SELECT 'batch_list', moved.id, moved.batch_id, to_jsonb(moved.*), 'system-cron-15day-retention', NOW()
     FROM moved`
  );
}

// MARKER_RECYCLEBIN_PURGE_30DAY_V1 -- ลบถาวรทุก Record ใน recycle_bin (ทุก Table รวมกัน) ที่เก่าเกิน 30 วัน
// (recycle_bin เป็นด่านสุดท้ายอยู่แล้ว -- ไม่ต้อง Archive ต่อไปไหนอีก ลบทิ้งจริงเลย)
async function checkAndPurgeRecycleBin() {
  await pool.query(
    `DELETE FROM recycle_bin WHERE deleted_at < NOW() - INTERVAL '30 days'`
  );
}

// Patch 94: Retention 1 เดือนเฉพาะ OCR Log ใน activity_log (action =
// 'ocr_completed'/'ocr_failed' ที่มาจาก AP OCR + DocCenter OCR หลัง Patch 93)
// เพราะถูกสร้างถี่มากทุกครั้งที่ Set ปิด ต่างจาก Action อื่น (เช่น อนุมัติ
// Serial) ที่ไม่ถี่เท่า จึงยังคงเก็บถาวรตามเดิม ไม่ลบทิ้งเป็น Log ทั่วไป
// ที่ไม่มีการกรอง action เลย
async function checkAndCleanupOcrActivityLog() {
  await pool.query(
    `DELETE FROM activity_log
     -- MARKER_ACTIVITYLOG_OCR_RETENTION_1MONTH_V1
     WHERE action IN ('ocr_completed', 'ocr_failed')
       AND created_at < NOW() - INTERVAL '1 month'`
  );
}

// MARKER_APP_IE_SIMPLE_DRAFTID_REMAP_CRON_V1 -- Safety Net: Remap draft_id ของ ie_simplevatdraft ที่ยังค้างเป็น Local ID
// (local-xxx) ทั้งที่ Invoice ต้นทางถูก Batch Export ไปแล้วจริง (bucket_list.batch_id
// IS NOT NULL) -- เก็บตกกรณี Remap ตอน Export (Frontend, วิธีที่ 1) พลาดไปด้วยสาเหตุใดก็ตาม
async function checkAndRemapIeSimpleDraftId() {
  const { rows } = await pool.query(
    `SELECT s.id AS simple_id, b.id AS bucket_id
     FROM ie_simplevatdraft s
     JOIN bucket_list b ON b.local_id = s.draft_id
     WHERE s.menu_source = 'ie_vat'
       AND s.status = 'pre-export'
       AND s.draft_id LIKE 'local-%'
       AND b.batch_id IS NOT NULL`
  );
  for (const row of rows) {
    await pool.query(`UPDATE ie_simplevatdraft SET draft_id = $1 WHERE id = $2`, [String(row.bucket_id), row.simple_id]);
  }
}

// MARKER_APP_MAINTENANCE_COUNTDOWN_CRON_V1 -- Cron ฝั่ง Server เป็นคนจริงที่ Flip maintenance_mode ตอนหมดเวลา
// (ไม่ต้องพึ่ง Client/Owner เปิดหน้าเว็บอยู่ตอนนั้น -- แก้ช่องโหว่ของวิธี
// Client-only เดิม ที่ถ้าไม่มี Owner Online ตอนหมดเวลา จะไม่มีใคร Flip Flag)
async function checkAndEnforceMaintenanceSchedule() {
  const { rows } = await pool.query(
    `SELECT key, value FROM system_settings WHERE key IN ('maintenance_mode', 'maintenance_scheduled_at')`
  );
  const settings = {};
  rows.forEach(r => { settings[r.key] = r.value; });
  const scheduledAt = settings.maintenance_scheduled_at || '';
  const isClosedNow = settings.maintenance_mode === 'true';
  if (!scheduledAt || isClosedNow) return; // ไม่มี Countdown ค้างอยู่ หรือปิดไปแล้วอยู่แล้ว -- ไม่ต้องทำอะไร
  const remainingMs = new Date(scheduledAt).getTime() - Date.now();
  if (remainingMs > 0) return; // ยังไม่ถึงเวลา
  const nowIso = new Date().toISOString();
  await pool.query(
    `INSERT INTO system_settings (key, value, updated_by, updated_at) VALUES ($1, $2, $3, $4)
     ON CONFLICT (key) DO UPDATE SET value = $2, updated_by = $3, updated_at = $4`,
    ['maintenance_mode', 'true', 'system-cron', nowIso]
  );
  await pool.query(
    `INSERT INTO system_settings (key, value, updated_by, updated_at) VALUES ($1, $2, $3, $4)
     ON CONFLICT (key) DO UPDATE SET value = $2, updated_by = $3, updated_at = $4`,
    ['maintenance_scheduled_at', '', 'system-cron', nowIso]
  );
  wsBroadcast('maintenance_mode_changed', { key: 'maintenance_mode', value: 'true' });
  console.log('[Maintenance Cron] Countdown หมดเวลา -- ปิด Full Maintenance โดยอัตโนมัติ (Server-side)');
}

const port = process.env.PORT || 4000;

// -- WebSocket Server � Real-time push ????? Client --------------------------
// -- Frontend ?????? ws://host:4000 ??????? event ????? reload ?????? --------
export function wsBroadcast(event, data = {}) {
  if (!global._wss) return;
  const msg = JSON.stringify({ event, ...data });
  global._wss.clients.forEach(client => {
    if (client.readyState === 1) client.send(msg);
  });
}

const server = app.listen(port, "0.0.0.0", () => {
  console.log(`API running on port ${port}`);

  // -- Attach WebSocket Server ????? HTTP Server ???? (port ????????) --
  const wss = new WebSocketServer({ server });
  global._wss = wss;

  // -- Heartbeat: ??? Firewall/Proxy/VPN ??? Connection ???????? Traffic ??????? --
  // -- (?????????????? 60-120 ??) ??? ping ??? 30 ?? ??? client ?????? pong ????? --
  // -- ???????? ????????????? -> terminate() ???? (??? memory leak client ????) --
  // -- Browser ??? pong ??????????????? WebSocket protocol ?????????????? Frontend --
  function markAlive() { this.isAlive = true; }
  // MARKER_APP_WS_PRESENCE_V2 -- Presence (เข้า/ออกระบบของทีม) ให้ Backend เป็นผู้ตัดสินทั้งหมด
  // -- ส่ง 'team_presence' เฉพาะ Client ที่ "ควรเห็น" (Owner เห็นทุกคน / คนอื่นต้องมี Permission ซ้อนกัน)
  // -- Frontend แค่แสดง Toast ตามที่ได้รับ ไม่ต้อง Query/Dedupe/เดาเอง
  const TEAM_PERMISSION_KEYS = ['VAT', 'I-Pro', 'GL', 'IE', 'Function', 'Manual', 'ApproveBatch'];
  const PRESENCE_GRACE_MS = 8000; // Refresh/Reconnect กลับมาทันภายในเวลานี้ = ไม่ถือว่าออกจากระบบ
  const presenceGrace = new Map(); // username -> Timeout (รอ Offline)
  const hasOtherConn = (self) => [...wss.clients].some(c => c !== self && c.readyState === 1 && c.username === self.username);

  async function announcePresence(subject, kind) {
    try {
      const recipients = [...wss.clients].filter(c => c.readyState === 1 && c.username && c.username !== subject);
      if (recipients.length === 0) return;
      const names = [...new Set([subject, ...recipients.map(c => c.username)])];
      const { rows } = await pool.query(
        `SELECT username, role, permissions FROM user_roles WHERE username = ANY($1)`,
        [names]
      );
      const byName = new Map(rows.map(r => [r.username, r]));
      const subj = byName.get(subject);
      const msg = JSON.stringify({ event: 'team_presence', id: `${subject}|${kind}|${Date.now()}`, username: subject, kind });
      for (const c of recipients) {
        const me = byName.get(c.username);
        if (!me) continue;
        const isOwner = me.role === 'Owner';
        const overlap = TEAM_PERMISSION_KEYS.some(k => me.permissions?.[k] && subj?.permissions?.[k]);
        if (isOwner || overlap) { try { c.send(msg); } catch (e) {} }
      }
    } catch (e) { console.error('[WS presence] announce error:', e.message); }
  }

  async function goOffline(u) {
    try {
      await pool.query(`DELETE FROM menu_active_sessions WHERE session_id = $1`, [u]);
    } catch (e) { console.error('[WS presence] cleanup menu_active_sessions error:', e.message); }
    wsBroadcast('team_status_updated', { username: u, online: false }); // ให้ Home/Sidebar Refresh รายชื่อทีม
    announcePresence(u, 'logout');
  }

  wss.on('connection', (ws, req) => {
    ws.isAlive = true;
    // MARKER_APP_WS_DISCONNECT_OFFLINE_V1
    // ── อ่าน Username จาก Query String (?user=xxx ที่ wsManager.js ส่งมา) ──
    // ── เก็บไว้ที่ ws.username เพื่อรู้ว่า Connection นี้เป็นของใคร ──────────
    try {
      const url = new URL(req.url, `http://${req.headers.host}`);
      ws.username = url.searchParams.get('user') || null;
    } catch (e) { ws.username = null; }
    // MARKER_APP_WS_PRESENCE_V2 -- Backend คุม Login/Logout Presence เอง (Source of Truth) ไม่พึ่ง Frontend ยิง Event
    // -- ถ้า User นี้เพิ่งหลุดและกำลังรอ Grace (Refresh/เน็ตสะดุด) แล้วกลับเข้ามาทัน = ยังไม่ใช่ Login ใหม่ ไม่ประกาศอะไร
    if (ws.username) {
      const pendingOffline = presenceGrace.get(ws.username);
      if (pendingOffline) {
        clearTimeout(pendingOffline);
        presenceGrace.delete(ws.username);
      } else if (!hasOtherConn(ws)) {
        wsBroadcast('team_status_updated', { username: ws.username }); // ให้ Home/Sidebar Refresh รายชื่อทีม
        announcePresence(ws.username, 'login');
      }
    }
    ws.on('pong', markAlive);
    ws.on('error', (err) => console.error('[WS] client error:', err.message));
    // ── Connection ขาด (ปิด Tab/เน็ตหลุด/Heartbeat Terminate ก็เข้าทางนี้ ──
    // ── เหมือนกัน เพราะ ws.terminate() ก็ Trigger 'close' Event ปกติ) ──────
    // ── ลบ Session ทันที + Broadcast ให้คนอื่นเห็น Offline แบบ Real-time ────
    // ── ไม่ต้องรอ Cutoff 5 นาทีจาก last_seen อีกต่อไป ──────────────────────
    ws.on('close', (code) => {
      if (!ws.username) return;
      const u = ws.username;
      if (hasOtherConn(ws)) return; // MARKER_APP_WS_CLOSE_LAST_CONN_ONLY_V1 -- ยังมี Connection อื่นของ User เดียวกันเปิดอยู่ = ยังไม่ Offline จริง
      // MARKER_APP_WS_PRESENCE_V2 -- code 4000 = Frontend Logout/Force Logout ตั้งใจปิด -> Offline ทันที
      // -- code อื่น (ปิดแท็บ/Refresh/เน็ตหลุด/Heartbeat Terminate) -> รอ Grace กัน Refresh แล้วขึ้น Logout ปลอม
      if (code === 4000) {
        const pending = presenceGrace.get(u);
        if (pending) { clearTimeout(pending); presenceGrace.delete(u); }
        goOffline(u);
        return;
      }
      if (presenceGrace.has(u)) return;
      presenceGrace.set(u, setTimeout(() => {
        presenceGrace.delete(u);
        if (![...wss.clients].some(c => c.readyState === 1 && c.username === u)) goOffline(u);
      }, PRESENCE_GRACE_MS));
    });
  });
  const wsHeartbeatInterval = setInterval(() => {
    wss.clients.forEach((ws) => {
      if (ws.isAlive === false) return ws.terminate();
      ws.isAlive = false;
      ws.ping();
    });
  }, 30000);
  wss.on('close', () => clearInterval(wsHeartbeatInterval));

  console.log(`WebSocket ready on ws://0.0.0.0:${port}`);

  // ── Cron Job: เก็บ RAM Snapshot + เช็ค Auto-Close AP Period ทุก 5 นาที ──
  const RAM_SNAPSHOT_INTERVAL_MS = 5 * 60 * 1000;
  // MARKER_APP_DATAINTEGRITY_REMOVED_V1 -- ถอด DATA_INTEGRITY_CHECK_INTERVAL_MS ออกแล้ว (ไม่ใช้แล้ว)
  setInterval(async () => {
    try {
      await takeRamSnapshot();
      wsBroadcast("ram_snapshot_updated", {}); // frontend fetch ข้อมูลล่าสุดเองผ่าน endpoint เดิม
    } catch (err) {
      console.error("RAM snapshot cron error:", err.message);
    }
    try {
      await takeCpuSnapshot();
      wsBroadcast("cpu_snapshot_updated", {});
    } catch (err) {
      console.error("CPU snapshot cron error:", err.message);
    }
    try {
      await checkAutoCloseRequest();
    } catch (err) {
      console.error("Auto-close AP period cron error:", err.message);
    }
    try {
      await checkAndSyncPeriodStatus();
    } catch (err) {
      console.error("Sync AP period status cron error:", err.message);
    }
    try {
      await checkAutoCloseIERequest();
    } catch (err) {
      console.error("Auto-close IE period cron error:", err.message);
    }
    try {
      await checkAndSyncIEPeriodStatus();
    } catch (err) {
      console.error("Sync IE period status cron error:", err.message);
    }
    // MARKER_VATPERIOD_NO_CRON_V1 -- VAT ไม่ต้องมี Cron เพราะไม่มี Pre-close/Blocked/Request-Close ให้ Sync (ตกลงกันไว้ก่อนหน้าแล้ว)
    try {
      await checkAndCleanupFileStorage();
    } catch (err) {
      console.error("File storage cleanup cron error:", err.message);
    }
    try {
      await checkAndCleanupSupportThreads();
    } catch (err) {
      console.error("Support & Feedback recycle bin cleanup cron error:", err.message);
    }
    try {
      await checkSupportThreadReminders();
    } catch (err) {
      console.error("Support & Feedback reminder cron error:", err.message);
    }
    try {
      await checkAutoAgreeThreads();
    } catch (err) {
      console.error("Support & Feedback auto-agree cron error:", err.message);
    }
    try {
      await checkTestingRecall();
    } catch (err) {
      console.error("Support & Feedback testing-recall cron error:", err.message);
    }
    try {
      await checkAndRestoreNewThreadNotifications();
    } catch (err) {
      console.error("Support & Feedback restore new-thread notification cron error:", err.message);
    }
    try {
      await checkAndCleanupExpiredAcceptNotifications();
    } catch (err) {
      console.error("Support & Feedback accept-expiry cron error:", err.message);
    }
    try {
      await checkAndCleanupApprovedNotifications();
    } catch (err) {
      console.error("Approved notifications cleanup cron error:", err.message);
    }
    try {
      await checkAndCleanupBatchList();
    } catch (err) {
      console.error("batch_list 15-day retention cron error:", err.message);
    }
    try {
      await checkAndPurgeRecycleBin(); // MARKER_RECYCLEBIN_PURGE_30DAY_V1
    } catch (err) {
      console.error("recycle_bin 30-day purge cron error:", err.message);
    }
    try {
      await checkAndCleanupBatchComments();
    } catch (err) {
      console.error("batch_comments retention cron error:", err.message);
    }
    try {
      await checkAndCleanupOcrActivityLog();
    } catch (err) {
      console.error("activity_log OCR retention cron error:", err.message);
    }
    try {
      await purgeExpiredTaxClosePeriods(); // MARKER_TAXCLOSE_LIFECYCLE_V1 -- ล้างข้อมูล Timeline ปิดภาษีหลังปิด Period ครบ N วัน
    } catch (err) {
      console.error("tax close timeline purge cron error:", err.message);
    }
    try {
      await checkAndRemapIeSimpleDraftId();
    } catch (err) {
      console.error("IE Simple draft_id remap cron error:", err.message); // MARKER_APP_IE_SIMPLE_DRAFTID_REMAP_CRON_V1
    }
    try {
      await autoCleanJunk();
    } catch (err) {
      console.error("auto clean junk cron error:", err.message);
    }
    try {
      await checkAndCleanupUnmatchedNotes(); // MARKER_APP_NOTES_CLEANUP_UNMATCHED_V1
    } catch (err) {
      console.error("vat_watchlist_notes unmatched cleanup cron error:", err.message);
    }
  }, RAM_SNAPSHOT_INTERVAL_MS);

  // MARKER_APP_DATAINTEGRITY_REMOVED_V1 -- ถอด Cron ตรวจ bucket_list Branch Label ว่างออกแล้ว (2026-09-28)
  // เดิมเรียก checkBucketListDataIntegrity() ทุก DATA_INTEGRITY_CHECK_INTERVAL_MS -- ดูเหตุผลที่ import ด้านบนไฟล์

  // MARKER_DOCCOLLECTION_AUTOCONFIRM_CRON_V1 -- Cron Auto-Confirm Cross Check (doc_collection) (2026-09-28)
  // เหตุผล: Cross Check ยังคงบังคับทำตามปกติ (ไม่เปลี่ยน Gate การ Download ใดๆ) แต่ถ้าเอกสารถูกโหลดออก
  // ไปแล้ว (ผ่านช่องทางที่ไม่ผ่าน Gate เช่นปุ่ม "PDF"/รูปแนบ หรือโหลดผ่าน Gate ตามปกติ) และผ่านมาแล้ว
  // 6 ชม.นับจาก downloaded_at โดยยังไม่มีใครกด Confirm เอง ให้ระบบ Confirm ให้อัตโนมัติ (นับว่า "ถือว่า
  // ตรวจแล้ว" เพราะไฟล์ถูกใช้งานออกไปจริง) เงื่อนไขครบ 3 อย่าง: fill_started_at, created_at, downloaded_at
  // ต้องไม่ว่างทั้งหมด และ downloaded_at ต้องผ่านมาแล้ว >= 6 ชม. -- ใช้ downloaded_at เป็นฐานเวลาเพราะเป็น
  // Trigger ตัวสุดท้ายที่เกิดขึ้นจริง (ถ้ายังไม่เคยโหลดเลย จะไม่มีวัน Auto-Confirm — ยังคงบังคับต้องทำ
  // Cross Check ปกติอยู่ดี) ยกเว้นเคส AP09/Inputsummary ที่ Auto-Confirm ตั้งแต่ตอน Save อยู่แล้ว (ไม่เข้าเงื่อนไขนี้
  // เพราะ cross_check.confirmed เป็น true อยู่ก่อนแล้ว) -- ต้อง ALTER TABLE doc_collection ADD COLUMN
  // downloaded_at TIMESTAMP ก่อน Deploy ไฟล์นี้ (ดู schema/doc_collection_downloaded_at_v1.sql)
  const DOCCOLLECTION_AUTOCONFIRM_INTERVAL_MS = 30 * 60 * 1000; // เช็คทุก 30 นาที
  const DOCCOLLECTION_AUTOCONFIRM_HOURS = 6;
  setInterval(async () => {
    try {
      const { rows } = await pool.query(
        `UPDATE doc_collection
         SET cross_check = COALESCE(cross_check, '{}'::jsonb)
                            || jsonb_build_object(
                                 'confirmed', true,
                                 'confirmed_at', to_jsonb(NOW()),
                                 'confirmed_by', 'system-auto-6h',
                                 'completed_at', to_jsonb(NOW())
                               )
         WHERE status <> 'draft'
           AND fill_started_at IS NOT NULL
           AND created_at IS NOT NULL
           AND downloaded_at IS NOT NULL
           AND downloaded_at <= NOW() - INTERVAL '${DOCCOLLECTION_AUTOCONFIRM_HOURS} hours'
           AND COALESCE((cross_check->>'confirmed')::boolean, false) = false
         RETURNING id, serial_code`
      );
      if (rows.length > 0) {
        console.log(`[MARKER_DOCCOLLECTION_AUTOCONFIRM_CRON_V1] Auto-confirmed ${rows.length} doc_collection row(s):`, rows.map(r => r.serial_code || r.id).join(', '));
      }
    } catch (err) {
      console.error('[MARKER_DOCCOLLECTION_AUTOCONFIRM_CRON_V1] error:', err.message);
    }
  }, DOCCOLLECTION_AUTOCONFIRM_INTERVAL_MS);

  // MARKER_APP_MAINTENANCE_COUNTDOWN_CRON_V1 -- เช็คถี่กว่า Cron อื่น (15 วิ) เพราะ Query เดียวเบามาก
  // และ User ต้องการให้ปิดตรงเวลาที่ตั้ง Countdown ไว้ ไม่ใช่รอ 5 นาที
  const MAINTENANCE_CHECK_INTERVAL_MS = 15 * 1000;
  setInterval(async () => {
    try {
      await checkAndEnforceMaintenanceSchedule();
    } catch (err) {
      console.error("Maintenance countdown cron error:", err.message);
    }
  }, MAINTENANCE_CHECK_INTERVAL_MS);

  // ── เก็บ Snapshot แรกทันทีตอน Server เริ่มทำงาน ไม่ต้องรอ 5 นาทีแรก ──
  takeRamSnapshot().catch(err => console.error("Initial RAM snapshot error:", err.message));
  takeCpuSnapshot().catch(err => console.error("Initial CPU snapshot error:", err.message));
  checkAndSyncPeriodStatus().catch(err => console.error("Initial AP period sync error:", err.message));
  checkAndSyncIEPeriodStatus().catch(err => console.error("Initial IE period sync error:", err.message));
});