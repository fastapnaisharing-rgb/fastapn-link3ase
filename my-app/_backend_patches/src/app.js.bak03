// MARKER_APP_VAT_WATCHLIST_VENDOR_NAME_JUNK_CLEAN_V1 — ตามไฟล์ตัวอย่างที่พี่ส่งมา (a25471a1 /
// acc870aa) พบว่าเข้าใจผิดมาตลอด: ปัญหาไม่ใช่ "มีบาง Row เป็น Row สรุปยอด/Row คั่นปนมาทั้ง Row"
// (ที่ Filter เดิมตัดทิ้งทั้ง Row) แต่คือ vendor_name ของแทบทุก Row จริง (Invoice จริง มี invoice_ref/
// exp_amount ปกติ) มี "หาง" เป็น Footer ของรายงานเก่า (เส้นประ, "Total Group Branch", "รวมทั้งสิ้น",
// "====", "ตั้งแต่วันที่...", "หน้า: x/y") ต่อท้ายชื่อ Vendor จริงมาด้วย เช่น
// "บางนาคอมเพล็กซ์ บจก. (สาขาที่00001) -------------------- ... Total Group Branch : ..."
// ชื่อ Vendor จริงคือแค่ "บางนาคอมเพล็กซ์ บจก. (สาขาที่00001)" ส่วนที่เหลือเป็นขยะที่หลุดติดมาตอน
// Parse จาก PDF/Report ต้นทาง -- Filter แบบเดิม (ตัดทั้ง Row ถ้า vendor_name มีคำว่า "Total Group
// Branch" หรือมีเส้นประ) จะตัด Invoice จริงทิ้งเกือบหมดทั้งตาราง ผิดทางแต่แรก -- แก้ใหม่ให้ "ตัดหาง"
// ออกจาก vendor_name แทนการตัดทั้ง Row ทิ้ง (เก็บ Invoice ไว้ แค่ทำความสะอาด Field)
function cleanJunkVendorNameSql(alias = "w") {
  // ตัดตั้งแต่เส้นประยาว (4 ตัวขึ้นไป) แรกที่เจอไปจนจบ String แล้ว Trim ช่องว่างท้ายที่เหลือ
  return `(CASE WHEN ${alias}.vendor_name ~ '-{4,}'
    THEN TRIM(regexp_replace(${alias}.vendor_name, '-{4,}.*$', ''))
    ELSE ${alias}.vendor_name END)`;
}
// ใช้ฝั่ง JS (ตอน Insert ข้อมูลใหม่เข้า vat_watchlist_report) -- Logic เดียวกับ SQL ด้านบนเป๊ะๆ
function cleanJunkVendorNameJs(vendorName) {
  if (typeof vendorName !== "string") return vendorName;
  const m = vendorName.match(/^(.*?)-{4,}/);
  if (!m) return vendorName;
  return m[1].trim();
}

// ── GET /api/vat_watchlist_detail?bu=XXX&bucket=realized|unrealized&bus_type=YYY ──
// MARKER_APP_MOUNT_VAT_WATCHLIST_DETAIL_V1 — ดึงรายการ Invoice ระดับละเอียดจาก vat_watchlist_report
// สำหรับ Popup "Expired Detail" ของ VatDashboard.js (เดิมเขียนไว้ใน routes/vatSummaryRoutes.js
// แต่ไฟล์นั้นไม่เคย import เข้า app.js จริง — ย้ายมา Mount ตรงนี้ให้ตรงกับ Pattern /api/... ของไฟล์นี้)
//   bu          → optional, ไม่ใส่ = เอาทุก BU (ใช้สำหรับสรุปยอดตาม Reason ข้ามทุก BU)
//   bucket=realized   → Expired แบบปกติ ไม่มี Reason แนบ (remark ว่าง)
//   bucket=unrealized → Expired ที่มี Reason แนบมาด้วย (remark ไม่ว่าง) ไม่ Hardcode เจาะจงแค่
//     'Check Return' แล้ว เพราะ "ไม่ว่าจะเป็นด้วยเหตุผลอะไรมันก็ต้องแสดงให้ได้"
//   ไม่ส่ง bucket → เอาทั้งหมดที่ Expired (ทั้ง Realized + Unrealized)
app.get("/api/vat_watchlist_detail", async (req, res) => {
  try {
    const { bu, bucket, bus_type } = req.query;
    const conditions = [`w.status = 'pending'`];
    const params = [];
    if (bu) {
      params.push(bu);
      conditions.push(`w.bu = $${params.length}`);
    }
    conditions.push(
      `(w.aging_label ILIKE '%expired%' OR (w.aging_label = 'Accept' AND COALESCE(w.remark, '') <> '') OR w.aging_months > 6)`
    );
    if (bucket === "realized") {
      conditions.push(`COALESCE(w.remark, '') = ''`);
    } else if (bucket === "unrealized") {
      conditions.push(`COALESCE(w.remark, '') <> ''`);
    }
    if (bus_type) {
      params.push(bus_type);
      conditions.push(`COALESCE(NULLIF(w.bus_type, ''), 'OTH') = $${params.length}`);
    }
    // MARKER_APP_VAT_WATCHLIST_DETAIL_VENDOR_NAME_CLEAN_SAFETY_NET_V1 — Safety Net เผื่อมี Row เก่าที่
    // ยังไม่ผ่านการ Clean DB (ตาม SQL ที่ให้ไป Run ใน pgAdmin) หลุดมา -- Override vendor_name ด้วย
    // Version ที่ตัดหาง Junk แล้วตอน Query (SELECT w.*, cleaned AS vendor_name -- node-postgres สร้าง
    // Object จาก Column ตามลำดับ ชื่อซ้ำกัน Column หลังสุดจะทับ Column ก่อนหน้าเสมอ จึงใช้ Pattern นี้
    // Override Field ซ้ำชื่อกันได้โดยไม่ต้อง List Column ทั้งหมดทีละตัว)
    const { rows } = await pool.query(
      `SELECT w.*, ${cleanJunkVendorNameSql("w")} AS vendor_name
       FROM vat_watchlist_report w WHERE ${conditions.join(" AND ")} ORDER BY w.exp_vat DESC NULLS LAST LIMIT 1000`,
      params
    );
    res.json(rows);
  } catch (err) {
    console.error("GET /api/vat_watchlist_detail error:", err);
    res.status(500).json({ error: "Failed to fetch vat_watchlist_detail" });
  }
});

// ── Reserve unique GRT/GRN number (ป้องกัน race condition + กันเลขซ้ำจริง) ──
// ── ล็อก row ด้วย transaction, บวกเลข, เช็คซ้ำกับข้อมูลจริงใน bucket_list, ────
// ── วนจนไม่ซ้ำ แล้วค่อย commit — ปลอดภัย 100% ไม่มีเลขถูกข้ามทิ้งแบบ block ──
app.post("/api/company_list/:id/reserve-unique-number", async (req, res) => {
  const { id } = req.params;
  const { field, prefix = '', bu = '', padLength = 4, semiUser = '', bootstrapField = '', checkPrefix = '' } = req.body;
  // MARKER_APP_ALLOW_OV_FIELDS_V1
  // MARKER_APP_ALLOW_SEMIUSER_FIELD_V1
  const allowedFields = ['ap_grt', 'ap_grn', 'ap_grt_ov', 'ap_grn_ov', 'batch_running', 'ap_grt_semiuser', 'ie_grt', 'ie_grn', 'ie_grt_ov', 'ie_grn_ov', 'ie_grt_prev', 'ie_grn_prev']; // MARKER_APP_RESERVE_UNIQUE_NUMBER_ALLOW_IE_FIELDS_V1 -- เพิ่ม field ของ IE (Column ยืนยันจาก pgAdmin แล้ว)
  if (!allowedFields.includes(field)) {
    return res.status(400).json({ error: "Invalid field. ???????? ap_grt, ap_grn ???? batch_running ????????" });
  }

  // -- batch_running: ??? Running ??? BU ?????? (Lazy Reset � ????????? Cron Job ???) --
  // -- ?????????????????? bucket_list ?????? GRT/GRN ??????????????????????????????? --
  if (field === 'batch_running') {
    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      const { rows: lockedRows } = await client.query(
        `SELECT batch_running, batch_running_date::text AS batch_running_date_txt,
                (NOW() AT TIME ZONE 'Asia/Bangkok')::date::text AS today_bkk
           FROM company_list WHERE id = $1 FOR UPDATE`,
        [id]
      );
      if (!lockedRows[0]) {
        await client.query('ROLLBACK');
        return res.status(404).json({ error: "Not found" });
      }
      // MARKER_APP_BATCHRUNNING_BKK_UNIQUE_V1
      // -- แก้บั๊ก Batch Name ซ้ำ: เดิมตัดวันด้วย UTC (Reset ตอน 07:00 น. ไทย) แต่ชื่อ Batch ใช้วันที่เวลาไทย --
      // -- ตอนนี้ตัดวันด้วย Asia/Bangkok ให้ตรงกับชื่อ Batch + เช็คซ้ำกับ batch_list จริงก่อนคืนเลข --
      const todayStr = lockedRows[0].today_bkk; // YYYY-MM-DD (เวลาไทย)
      const lastDateStr = lockedRows[0].batch_running_date_txt
        ? String(lockedRows[0].batch_running_date_txt).slice(0, 10)
        : null;
      // ????????????????????????? ? Reset ???????? 0 ???? ???????? +1
      let running = (lastDateStr === todayStr) ? (parseInt(lockedRows[0].batch_running, 10) || 0) : 0;
      running += 1;
      // -- ข้ามเลขที่มีอยู่แล้วใน batch_list (Frontend ส่ง checkPrefix = "{Base}/{SystemPrefix}-" มาให้) --
      if (checkPrefix) {
        for (let guard = 0; guard < 1000; guard++) {
          const cand = `${checkPrefix}${prefix}${String(running).padStart(padLength, '0')}`;
          const { rows: dup } = await client.query(`SELECT 1 FROM batch_list WHERE batch_id = $1 LIMIT 1`, [cand]);
          if (!dup.length) break;
          running += 1;
        }
      }
      const formatted = `${prefix}${String(running).padStart(padLength, '0')}`;
      await client.query(
        `UPDATE company_list SET batch_running = $1, batch_running_date = $2 WHERE id = $3`,
        [running, todayStr, id]
      );
      await client.query('COMMIT');
      // MARKER_APP_GRTGRN_BROADCAST_V1
      // -- Broadcast Real-time � ????????????????????????? (BU ????????) ------
      // -- ??????????????????????? ????????? Submit ??????? Error ----------
      wsBroadcast('grt_grn_reserved', { id, field, bu, value: running });
      return res.json({ value: running, formatted });
    } catch (err) {
      await client.query('ROLLBACK').catch(() => {});
      console.error('reserve-unique-number (batch_running) error:', err.message);
      return res.status(500).json({ error: "Internal server error" });
    } finally {
      client.release();
    }
  }

  // MARKER_APP_SEMIAUTO_GRT_CHANNEL_RESERVE_V1
  // -- Semi-Auto GRT: reserve เลขจาก Channel รายคน (ap_grt_semiuser[semiUser]) --
  // -- แยกจากเลขกลาง (ap_grt) โดยสิ้นเชิง -- ไม่แยกตาม Override/Current Period --
  // -- (Channel เป็น Counter เดี่ยวต่อ User เท่านั้น ไม่มี ov/prev variant) -------
  if (field === 'ap_grt_semiuser') {
    if (!semiUser) {
      return res.status(400).json({ error: "Missing semiUser" });
    }
    // MARKER_APP_SEMIAUTO_GRT_BOOTSTRAP_WHITELIST_V1
    // -- Whitelist ชื่อ Column ที่จะใช้ Bootstrap กัน SQL Injection ผ่านชื่อ Column --
    const allowedBootstrapFields = ['ap_grt', 'ap_grt_prev', 'ap_grt_ov'];
    const bField = allowedBootstrapFields.includes(bootstrapField) ? bootstrapField : 'ap_grt';
    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      const { rows: lockedRows } = await client.query(
        `SELECT ap_grt_semiuser, "${bField}" AS bootstrap_val FROM company_list WHERE id = $1 FOR UPDATE`,
        [id]
      );
      if (!lockedRows[0]) {
        await client.query('ROLLBACK');
        return res.status(404).json({ error: "Not found" });
      }
      const channels = lockedRows[0].ap_grt_semiuser || {};
      // MARKER_APP_SEMIAUTO_GRT_BOOTSTRAP_LOGIC_V1
      // -- ถ้า Channel ของ User นี้ยังไม่เคยมีมาก่อน -- Bootstrap เริ่มนับจาก --
      // -- เลขกลาง (bField) แทนเริ่มจาก 0 ให้ตรงกับที่ Frontend โชว์ Fallback --
      const existingRunning = channels[semiUser]?.running_num;
      let running = (existingRunning !== undefined && existingRunning !== null && existingRunning !== '')
        ? (parseInt(existingRunning, 10) || 0)
        : (parseInt(lockedRows[0].bootstrap_val, 10) || 0);
      let formatted = '';
      let attempts = 0;
      const MAX_ATTEMPTS = 10000;
      while (attempts < MAX_ATTEMPTS) {
        running += 1;
        formatted = `${prefix}${String(running).padStart(padLength, '0')}`;
        const { rows: dupRows } = await client.query(
          `SELECT 1 FROM bucket_list WHERE bu = $1 AND form_data->>'grtNum' = $2 LIMIT 1`,
          [bu, formatted]
        );
        if (dupRows.length === 0) break;
        attempts += 1;
      }
      if (attempts >= MAX_ATTEMPTS) {
        await client.query('ROLLBACK');
        return res.status(500).json({ error: "หาเลขที่ไม่ซ้ำไม่สำเร็จ (พยายามครบจำนวนสูงสุดแล้ว)" });
      }
      channels[semiUser] = { running_num: String(running).padStart(padLength, '0'), updated_at: new Date().toISOString() };
      await client.query(`UPDATE company_list SET ap_grt_semiuser = $1 WHERE id = $2`, [JSON.stringify(channels), id]);
      await client.query('COMMIT');
      wsBroadcast('grt_grn_reserved', { id, field: 'ap_grt_semiuser', bu, value: running, semiUser });
      return res.json({ value: running, formatted });
    } catch (err) {
      await client.query('ROLLBACK').catch(() => {});
      console.error('reserve-unique-number (ap_grt_semiuser) error:', err.message);
      return res.status(500).json({ error: "Internal server error" });
    } finally {
      client.release();
    }
  }

  const jsonKey = field.includes('grt') ? 'grtNum' : 'grn'; // MARKER_APP_RESERVE_UNIQUE_NUMBER_ALLOW_IE_FIELDS_V1 -- generalize ให้รองรับทุก prefix (ap_/ie_/vat_) ไม่ hardcode เฉพาะ ap_grt
  const col = `"${field}"`;
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    const { rows: lockedRows } = await client.query(
      `SELECT ${col} FROM company_list WHERE id = $1 FOR UPDATE`,
      [id]
    );
    if (!lockedRows[0]) {
      await client.query('ROLLBACK');
      return res.status(404).json({ error: "Not found" });
    }
    let running = parseInt(lockedRows[0][field], 10) || 0;
    let formatted = '';
    let attempts = 0;
    const MAX_ATTEMPTS = 10000;
    while (attempts < MAX_ATTEMPTS) {
      running += 1;
      formatted = `${prefix}${String(running).padStart(padLength, '0')}`;
      const { rows: dupRows } = await client.query(
        `SELECT 1 FROM bucket_list WHERE bu = $1 AND form_data->>'${jsonKey}' = $2 LIMIT 1`,
        [bu, formatted]
      );
      if (dupRows.length === 0) break;
      attempts += 1;
    }
    if (attempts >= MAX_ATTEMPTS) {
      await client.query('ROLLBACK');
      return res.status(500).json({ error: "?????????????????????????? (??????????????????????????)" });
    }
    await client.query(`UPDATE company_list SET ${col} = $1 WHERE id = $2`, [running, id]);
    await client.query('COMMIT');
    // -- Broadcast Real-time (?? Comment ????????????? batch_running branch) --
    wsBroadcast('grt_grn_reserved', { id, field, bu, value: running });
    res.json({ value: running, formatted });
  } catch (err) {
    await client.query('ROLLBACK').catch(() => {});
    console.error('reserve-unique-number error:', err.message);
    res.status(500).json({ error: "Internal server error" });
  } finally {
    client.release();
  }
});

// MARKER_APP_SEMIAUTO_GRT_SET_ENDPOINT_V1
// -- POST /api/company_list/:id/set-semiauto-grt ------------------------
// -- Frontend ตัดสินใจเลข GRT มาเรียบร้อยแล้ว (จาก Running ของ User เอง) --
// -- Endpoint นี้แค่ "บันทึกเลขที่ตัดสินใจแล้ว" ลง Channel ไม่คำนวณ/Increment --
// -- เอง และไม่เช็คซ้ำใดๆ ทั้งสิ้น (Frontend รับผิดชอบความถูกต้องของเลข) -----
app.post("/api/company_list/:id/set-semiauto-grt", async (req, res) => {
  const { id } = req.params;
  const { semiUser = '', running_num = '' } = req.body;
  if (!semiUser) {
    return res.status(400).json({ error: "Missing semiUser" });
  }
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    const { rows: lockedRows } = await client.query(
      `SELECT ap_grt_semiuser FROM company_list WHERE id = $1 FOR UPDATE`,
      [id]
    );
    if (!lockedRows[0]) {
      await client.query('ROLLBACK');
      return res.status(404).json({ error: "Not found" });
    }
    const channels = lockedRows[0].ap_grt_semiuser || {};
    channels[semiUser] = { running_num: String(running_num), updated_at: new Date().toISOString() };
    await client.query(`UPDATE company_list SET ap_grt_semiuser = $1 WHERE id = $2`, [JSON.stringify(channels), id]);
    await client.query('COMMIT');
    wsBroadcast('grt_grn_reserved', { id, field: 'ap_grt_semiuser', bu: req.body.bu || '', value: parseInt(running_num, 10) || 0, semiUser });
    return res.json({ ok: true, semiUser, running_num: channels[semiUser].running_num });
  } catch (err) {
    await client.query('ROLLBACK').catch(() => {});
    console.error('set-semiauto-grt error:', err.message);
    return res.status(500).json({ error: "Internal server error" });
  } finally {
    client.release();
  }
});
