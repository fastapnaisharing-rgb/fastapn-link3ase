});
// MARKER_APP_NOTES_CLEANUP_UNMATCHED_V1
// -- ลบ Note ที่ note_at เกิน 30 วัน + ไม่ Match กับแถวไหนใน vat_watchlist_report --
// -- เลยแล้ว (Invoice สมบูรณ์ไปแล้ว ไม่อยู่ใน Incomplete Report อีกต่อไป) --
async function checkAndCleanupUnmatchedNotes() { // MARKER_APP_NOTES_CLEANUP_UNMATCHED_SINCE_V1
  // ── ขั้นตอน 1: Note ที่เพิ่ง Unmatch ครั้งแรก -> บันทึกวันที่เริ่ม Unmatch ──
  await pool.query(`
    UPDATE vat_watchlist_notes n
    SET unmatched_since = NOW()
    WHERE unmatched_since IS NULL
    AND NOT EXISTS (
      SELECT 1 FROM vat_watchlist_report r
      WHERE r.bu = n.bu AND r.invoice_ref = n.invoice_ref AND r.supplier_code = n.supplier_code
    )
  `);
  // ── ขั้นตอน 2: Note ที่กลับมา Match อีกครั้ง -> Reset unmatched_since ──
  await pool.query(`
    UPDATE vat_watchlist_notes n
    SET unmatched_since = NULL
    WHERE unmatched_since IS NOT NULL
    AND EXISTS (
      SELECT 1 FROM vat_watchlist_report r
      WHERE r.bu = n.bu AND r.invoice_ref = n.invoice_ref AND r.supplier_code = n.supplier_code
    )
  `);
  // MARKER_APP_NOTES_UNMATCH_WARNING_V1
  // ── ขั้นตอน 2.5: Note ที่ Unmatch ใกล้ครบ 30 วัน (เหลือไม่เกิน 24 ชม.) -> แจ้งเตือน Bell ──
  const { rows: expiringNotes } = await pool.query(`
    SELECT id FROM vat_watchlist_notes
    WHERE unmatched_since IS NOT NULL
    AND unmatched_since < NOW() - INTERVAL '29 days'
    AND unmatched_since >= NOW() - INTERVAL '30 days'
    AND remark = 'Check Return' -- MARKER_APP_NOTES_CLEANUP_CHECKRETURN_ONLY_V1
  `);
  if (expiringNotes.length > 0) {
    await pool.query(`DELETE FROM notifications WHERE category = 'VAT_NOTE_UNMATCH_WARNING'`);
    await pool.query(
      `INSERT INTO notifications (title, message, category, action_type, target_permission, created_by, read_by)
       VALUES ($1, $2, 'VAT_NOTE_UNMATCH_WARNING', 'NOTE_UNMATCH_WARNING', 'VAT', 'system (auto)', '[]'::jsonb)`,
      [
        `Note ใกล้ถูกลบอัตโนมัติ (${expiringNotes.length} รายการ)`,
        `มี Note จำนวน ${expiringNotes.length} รายการ ที่ Unmatch ต่อเนื่องมาเกือบ 30 วัน จะถูกลบอัตโนมัติภายใน 24 ชม. ถ้ายังไม่มีการ Match กลับมา`,
      ]
    );
  }
  // ── ขั้นตอน 3: Note ที่ Unmatch ต่อเนื่องเกิน 30 วัน -> ลบทิ้ง ──
  const result = await pool.query(`
    DELETE FROM vat_watchlist_notes
    WHERE unmatched_since IS NOT NULL
    AND unmatched_since < NOW() - INTERVAL '30 days'
    AND remark = 'Check Return' -- MARKER_APP_NOTES_CLEANUP_CHECKRETURN_ONLY_V1
    RETURNING id
  `);
  if (result.rowCount > 0) {
    console.log(`[checkAndCleanupUnmatchedNotes] Deleted ${result.rowCount} notes unmatched for 30+ days`);
  }
}

// MARKER_APP_VAT_WATCHLIST_REPLACE_BU_TRANSACTION_V1
// -- POST /api/vat_watchlist_report/replace_bu -- Delete BU เก่า + Insert ข้อมูลใหม่ --
// -- ทั้งหมดในธุรกรรมเดียวกัน (BEGIN...COMMIT / ROLLBACK) กัน Delete สำเร็จ --
// -- แต่ Insert ไม่ครบ (Network ขาด/Server พังกลางทาง) -- ต้องอยู่ก่อน Generic Mount --
const VAT_REPORT_INSERT_COLUMNS = [
  'doc_date','doc_no','site','pay_group','branch','tax_type','invoice_ref','supplier_code',
  'vendor_name','phone','payment_date','check_date','check_no','receive_doc_date','receive_doc_no',
  'exp_amount','exp_vat','avg_amount','avg_vat','ap_source','ap_batch_name','bu','bus_type','sub_type',
  'payment_type','related_persons','period','aging_months','aging_label','status',
];

function buildVatReportBulkInsert(rows) {
  const cols = VAT_REPORT_INSERT_COLUMNS;
  const values = [];
  const placeholders = rows.map((row, i) => {
    const base = i * cols.length;
    const ph = cols.map((_, j) => `$${base + j + 1}`).join(', ');
    cols.forEach((col) => values.push(row[col] === undefined ? null : row[col]));
    return `(${ph})`;
  }).join(', ');
  const sql = `INSERT INTO vat_watchlist_report (${cols.join(', ')}) VALUES ${placeholders}`;
  return { sql, values };
}

// MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_REF_JOIN_V1
// -- Sync 2 คอลัมน์ old_ref_check_no / old_ref_pay_date บน vat_watchlist_report --
// -- จาก vat_watchlist_old_incomplete_ref (Join Key 4 ช่อง: bu+invoice_ref+supplier_code+exp_amount+exp_vat) --
// -- เรียกทุกครั้งหลัง Insert ข้อมูล Incomplete ใหม่ (replace_bu) และตอน Confirm Save จากหน้า Old Incomplete --
// -- Ref Table ไม่เคยถูกแตะตอน Delete+Insert ปกติ ทำให้ Invoice ที่หายไปแล้วโผล่กลับมาใหม่ ก็ยังได้ Ref คืนอัตโนมัติ --
async function applyOldIncompleteRefJoin(client, busFilter) {
  const params = [];
  let busClause = "";
  if (Array.isArray(busFilter) && busFilter.length > 0) {
    params.push(busFilter);
    busClause = "AND r.bu = ANY($1::text[])";
  }
  await client.query(
    `UPDATE vat_watchlist_report r
     SET old_ref_check_no = ref.check_no,
         old_ref_pay_date = ref.payment_date_old
     FROM vat_watchlist_old_incomplete_ref ref
     WHERE r.bu = ref.bu
       AND r.invoice_ref = ref.invoice_ref
       AND r.supplier_code = ref.supplier_code
       AND ROUND(r.exp_amount::numeric, 2) = ROUND(ref.exp_amount, 2)
       AND ROUND(r.exp_vat::numeric, 2) = ROUND(ref.exp_vat, 2)
       ${busClause}`,
    params
  );
}

// MARKER_APP_VAT_WATCHLIST_REPORT_JUNK_ROW_GUARD_V2 — ตามที่ขอ "ไม่ว่าจะทำ Watchlist หรือว่าอะไรก็ตาม"
// -- แก้จาก V1: V1 เข้าใจผิดว่า "Total Group Branch" เป็นแถว Junk แยกต่างหาก เลยกรองทั้ง Row ทิ้ง
// ไปเลย แต่จากไฟล์ตัวอย่างจริงที่ส่งมา (a25471a1 / acc870aa) พบว่า Row เหล่านี้คือ Invoice จริงปกติ
// (มี id/invoice_ref/exp_amount จริง) แค่ vendor_name มีหางของ Footer รายงานเก่า (เส้นประ, "Total
// Group Branch", "รวมทั้งสิ้น", "====", วันที่, เลขหน้า) ติดมาด้วย -- ถ้ากรองทั้ง Row ทิ้งจะเสีย
// Invoice จริงไปเกือบทั้งตาราง เปลี่ยนมาเป็น "ตัดหาง" ออกจาก vendor_name แค่ Field เดียว เก็บ Row ไว้
// ครบ ไม่ว่าจะมาจาก Excel/Report ของ BU ไหนก็ตามที่ยิงเข้า replace_bu (ประตูทางเข้าหลักของ Watchlist)
app.post("/api/vat_watchlist_report/replace_bu", checkPermission("vat_watchlist_report", "write"), async (req, res) => {
  const { bus, rows: rawRows } = req.body || {};
  if (!Array.isArray(bus) || bus.length === 0) {
    return res.status(400).json({ error: "bus (array) is required" });
  }
  if (!Array.isArray(rawRows)) {
    return res.status(400).json({ error: "rows (array) is required" });
  }
  // ทำความสะอาด vendor_name ก่อน Insert -- เก็บ Row ไว้ครบทุก Row แค่ตัดหาง Junk ออกจาก vendor_name
  const rows = rawRows.map((r) => {
    if (r && typeof r.vendor_name === "string") {
      return { ...r, vendor_name: cleanJunkVendorNameJs(r.vendor_name) };
    }
    return r;
  });
  const client = await pool.connect();
  try {
    await client.query("BEGIN");
    // MARKER_APP_REPLACE_BU_KEEP_SEND_FP_V1 -- เก็บรายการที่ส่งไป Bucket ของ Full Page (status 'send_fp') ไว้ก่อนลบ แล้วคืนสถานะให้แถวที่ Match ใน Incomplete ใหม่ (bu+invoice_ref+supplier_code)
    const keepSendFp = await client.query("SELECT bu, invoice_ref, supplier_code FROM vat_watchlist_report WHERE bu = ANY($1::text[]) AND status = 'send_fp'", [bus]);
    await client.query("DELETE FROM vat_watchlist_report WHERE bu = ANY($1::text[])", [bus]);
    const REPLACE_BU_CHUNK_SIZE = 1000; // 1000 แถว x 30 คอลัมน์ = 30,000 Param (ไม่ชน Limit 65,535)
    for (let i = 0; i < rows.length; i += REPLACE_BU_CHUNK_SIZE) {
      const chunk = rows.slice(i, i + REPLACE_BU_CHUNK_SIZE);
      if (chunk.length === 0) continue;
      const { sql, values } = buildVatReportBulkInsert(chunk);
      await client.query(sql, values);
    }
    await applyOldIncompleteRefJoin(client, bus); // MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_REF_JOIN_CALL_V1
    if (keepSendFp.rowCount > 0) {
      await client.query(
        `UPDATE vat_watchlist_report r SET status = 'send_fp'
         FROM UNNEST($1::text[], $2::text[], $3::text[]) AS k(bu, invoice_ref, supplier_code)
         WHERE r.bu = k.bu AND r.invoice_ref = k.invoice_ref AND r.supplier_code IS NOT DISTINCT FROM k.supplier_code
           AND r.status = 'pending'`,
        [keepSendFp.rows.map((x) => x.bu), keepSendFp.rows.map((x) => x.invoice_ref), keepSendFp.rows.map((x) => x.supplier_code)]
      );
    }
    await client.query("COMMIT");
    res.json({ success: true, deleted_bu: bus, inserted: rows.length });
  } catch (err) {
    await client.query("ROLLBACK");
    console.error("vat_watchlist_report replace_bu error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  } finally {
    client.release();
  }
});
// MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_MATCH_PREVIEW_V1
// -- POST /api/vat_watchlist_old_incomplete_ref/match_preview --
// -- รับแถว Old Incomplete ที่ Frontend Parse + หา BU มาแล้ว -> Match กับ New Incomplete ปัจจุบัน --
// -- คืนเฉพาะแถวที่ Match ได้ พร้อมข้อมูลจริงจาก vat_watchlist_report ของแถวนั้น (ไม่ Insert อะไรทั้งสิ้น แค่ดูผลก่อน) --
function buildOldIncompleteMatchInput(rows) {
  const bu = [], invoiceRef = [], supplierCode = [], expAmount = [], expVat = [], checkNo = [], paymentDateOld = [], vendorNameOld = [];
  for (const row of rows) {
    const cn = String((row && row.check_no) || "").trim();
    if (!cn) continue; // MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_REQUIRE_CHECKNO_V1 -- เฉพาะแถวที่มีเลขที่เช็คแล้วเท่านั้น
    bu.push(row.bu);
    invoiceRef.push(row.invoice_ref);
    supplierCode.push(row.supplier_code);
    expAmount.push(row.exp_amount);
    expVat.push(row.exp_vat);
    checkNo.push(cn);
    paymentDateOld.push(row.payment_date_old || null);
    vendorNameOld.push(row.vendor_name || null); // MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_PREVIEW_VENDORNAME_V1 -- ชื่อผู้ขายจากไฟล์ Old Incomplete เอง (ไม่ได้ใช้ใน confirm_save เพราะ Ref Table ไม่มี Column นี้ -- ใช้เฉพาะ match_preview เป็น Fallback ให้ใบพี่น้อง)
  }
  return { bu, invoiceRef, supplierCode, expAmount, expVat, checkNo, paymentDateOld, vendorNameOld };
}

const OLD_INCOMPLETE_MATCH_SQL = `
  SELECT
    r.bu, r.invoice_ref, r.supplier_code, r.vendor_name, r.exp_amount, r.exp_vat,
    input.check_no AS old_ref_check_no, input.payment_date_old AS old_ref_pay_date
  FROM UNNEST($1::text[], $2::text[], $3::text[], $4::numeric[], $5::numeric[], $6::text[], $7::date[])
    AS input(bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old)
  JOIN vat_watchlist_report r
    ON r.bu = input.bu
    AND r.invoice_ref = input.invoice_ref
    AND r.supplier_code = input.supplier_code
    AND ROUND(r.exp_amount::numeric, 2) = ROUND(input.exp_amount, 2)
    AND ROUND(r.exp_vat::numeric, 2) = ROUND(input.exp_vat, 2)
  ORDER BY r.bu, r.invoice_ref
`;

// MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_PREVIEW_SIBLING_PULL_V1
// -- Preview แบบเดียวกับ confirm_save เป๊ะ: หา Direct Match ก่อน (bu+check_no ที่ Match ได้จริงอย่างน้อย 1 ใบ) --
// -- แล้วดึงทุกแถวใน Input ทั้งก้อนที่ใช้เลขที่เช็คเดียวกัน (ใบพี่น้อง) มาโชว์ด้วย -- ให้ตัวเลขที่ AP เห็นก่อนกด --
// -- Confirm ตรงกับจำนวนที่จะถูกบันทึกจริง (savedCount) ไม่ใช่แค่ directMatchCount เหมือนเดิม --
// -- is_direct_match: true = Match ตรงกับ Incomplete ปัจจุบันเป๊ะ, false = ใบพี่น้อง (Reference เท่านั้น --
// -- ไม่ได้ Match กับ Incomplete ปัจจุบัน จะไม่ถูกเขียนลง old_ref_check_no ของแถวไหนใน vat_watchlist_report เลย) --
const OLD_INCOMPLETE_MATCH_SIBLING_SQL = `
  WITH input AS (
    SELECT * FROM UNNEST($1::text[], $2::text[], $3::text[], $4::numeric[], $5::numeric[], $6::text[], $7::date[], $8::text[])
      AS t(bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old, vendor_name_old)
  ),
  direct AS (
    SELECT i.bu, i.invoice_ref, i.supplier_code, i.check_no, i.payment_date_old, r.vendor_name, r.exp_amount, r.exp_vat
    FROM input i
    JOIN vat_watchlist_report r
      ON r.bu = i.bu AND r.invoice_ref = i.invoice_ref AND r.supplier_code = i.supplier_code
      AND ROUND(r.exp_amount::numeric, 2) = ROUND(i.exp_amount, 2)
      AND ROUND(r.exp_vat::numeric, 2) = ROUND(i.exp_vat, 2)
  ),
  confirmed_checks AS (
    SELECT DISTINCT bu, check_no FROM direct
  )
  SELECT
    i.bu, i.invoice_ref, i.supplier_code,
    -- MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_PREVIEW_VENDORNAME_V1 -- Match ตรง ใช้ชื่อจาก vat_watchlist_report ปัจจุบัน (สด/แม่นสุด) -- ใบพี่น้อง Fallback ไปใช้ชื่อจากไฟล์ Old Incomplete เอง -- ไม่มีทั้งคู่ ว่างเปล่า
    COALESCE(d.vendor_name, NULLIF(i.vendor_name_old, ''), '') AS vendor_name,
    COALESCE(d.exp_amount, i.exp_amount) AS exp_amount,
    COALESCE(d.exp_vat, i.exp_vat) AS exp_vat,
    i.check_no AS old_ref_check_no, i.payment_date_old AS old_ref_pay_date,
    (d.invoice_ref IS NOT NULL) AS is_direct_match
  FROM input i
  JOIN confirmed_checks c ON c.bu = i.bu AND c.check_no = i.check_no
  LEFT JOIN direct d ON d.bu = i.bu AND d.invoice_ref = i.invoice_ref AND d.supplier_code = i.supplier_code
  ORDER BY i.bu, i.check_no, i.invoice_ref
`;

app.post("/api/vat_watchlist_old_incomplete_ref/match_preview", checkPermission("vat_watchlist_report", "write"), async (req, res) => {
  const { rows } = req.body || {};
  if (!Array.isArray(rows)) {
    return res.status(400).json({ error: "rows (array) is required" });
  }
  try {
    const input = buildOldIncompleteMatchInput(rows);
    const { rows: matched } = await pool.query(OLD_INCOMPLETE_MATCH_SIBLING_SQL, [
      input.bu, input.invoiceRef, input.supplierCode, input.expAmount, input.expVat, input.checkNo, input.paymentDateOld, input.vendorNameOld, // MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_PREVIEW_VENDORNAME_V1
    ]);
    const directMatchCount = matched.filter((m) => m.is_direct_match).length;
    const siblingCount = matched.length - directMatchCount;
    const byBuMap = {};
    for (const m of matched) byBuMap[m.bu] = (byBuMap[m.bu] || 0) + 1;
    const byBu = Object.keys(byBuMap).sort().map((bu) => ({ bu, count: byBuMap[bu] }));
    res.json({
      success: true,
      totalInput: rows.length,
      totalWithCheckNo: input.bu.length,
      matchedCount: matched.length,
      directMatchCount,
      siblingCount,
      byBu,
      matched,
    });
  } catch (err) {
    console.error("vat_watchlist_old_incomplete_ref match_preview error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  }
});

// MARKER_VATWATCHLISTOPS_OLDINCOMPLETE_CONFIRM_SAVE_V1
// -- POST /api/vat_watchlist_old_incomplete_ref/confirm_save --
// -- Re-match ซ้ำฝั่ง Backend จาก rows ดิบ (ไม่เชื่อผล Match ที่ Frontend ส่งมาเฉยๆ) --
// -- Insert เข้า Ref Table ถาวร (Upsert กันซ้ำด้วย Key 4 ช่อง) + Update 2 คอลัมน์บน vat_watchlist_report ทันที ในธุรกรรมเดียว --
app.post("/api/vat_watchlist_old_incomplete_ref/confirm_save", checkPermission("vat_watchlist_report", "write"), async (req, res) => {
  const { rows } = req.body || {};
  if (!Array.isArray(rows) || rows.length === 0) {
    return res.status(400).json({ error: "rows (array) is required" });
  }
  const input = buildOldIncompleteMatchInput(rows);
  if (input.bu.length === 0) {
    return res.json({ success: true, matchedCount: 0, savedCount: 0 });
  }
  const client = await pool.connect();
  try {
    await client.query("BEGIN");
    // MARKER_VATWATCHLISTOPS_OLDREF_SIBLING_PULL_V1
    // -- นับจำนวน (bu+check_no) ที่ยืนยัน Match กับ Incomplete ปัจจุบันได้จริง (Direct Match) ก่อน Insert จริง --
    // -- ไว้ Report แยกจาก savedCount (ที่รวมใบพี่น้องที่ดึงมาเพิ่มด้วย) --
    const { rows: directRows } = await client.query(
      `
      SELECT DISTINCT i.bu, i.check_no
      FROM UNNEST($1::text[], $2::text[], $3::text[], $4::numeric[], $5::numeric[], $6::text[], $7::date[])
        AS i(bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old)
      JOIN vat_watchlist_report r
        ON r.bu = i.bu AND r.invoice_ref = i.invoice_ref AND r.supplier_code = i.supplier_code
        AND ROUND(r.exp_amount::numeric, 2) = ROUND(i.exp_amount, 2)
        AND ROUND(r.exp_vat::numeric, 2) = ROUND(i.exp_vat, 2)
      `,
      [input.bu, input.invoiceRef, input.supplierCode, input.expAmount, input.expVat, input.checkNo, input.paymentDateOld]
    );
    const directMatchCount = directRows.length;
    const { rows: saved } = await client.query(
      `
      WITH input AS (
        SELECT * FROM UNNEST($1::text[], $2::text[], $3::text[], $4::numeric[], $5::numeric[], $6::text[], $7::date[])
          AS t(bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old)
      ),
      confirmed_checks AS (
        -- MARKER_VATWATCHLISTOPS_OLDREF_SIBLING_PULL_V1 -- (bu+check_no) ที่ยืนยัน Match ได้จริงอย่างน้อย 1 ใบ (เช็คใบนี้ยัง Relevant พอจะเก็บ Reference)
        SELECT DISTINCT i.bu, i.check_no
        FROM input i
        JOIN vat_watchlist_report r
          ON r.bu = i.bu AND r.invoice_ref = i.invoice_ref AND r.supplier_code = i.supplier_code
          AND ROUND(r.exp_amount::numeric, 2) = ROUND(i.exp_amount, 2)
          AND ROUND(r.exp_vat::numeric, 2) = ROUND(i.exp_vat, 2)
      ),
      matched AS (
        -- ดึงทุกแถวใน Input ทั้งก้อนที่ใช้เลขที่เช็คเดียวกับที่ยืนยัน Match แล้วอย่างน้อย 1 ใบ -- แม้บางใบจะไม่ Match กับ
        -- Incomplete ปัจจุบันแล้ว (เช่นจ่ายจบไปแล้ว) ก็ตาม -- เก็บไว้เป็นข้อมูลอ้างอิง (ไม่กระทบ vat_watchlist_report
        -- เพราะ applyOldIncompleteRefJoin Join แบบ Exact 4 ช่อง ใบพวกนี้ไม่มีวัน Match อะไรเพิ่มอยู่แล้ว)
        SELECT DISTINCT i.bu, i.invoice_ref, i.supplier_code, i.exp_amount, i.exp_vat, i.check_no, i.payment_date_old
        FROM input i
        JOIN confirmed_checks c ON c.bu = i.bu AND c.check_no = i.check_no
      )
      INSERT INTO vat_watchlist_old_incomplete_ref (bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old)
      SELECT bu, invoice_ref, supplier_code, exp_amount, exp_vat, check_no, payment_date_old FROM matched
      ON CONFLICT ON CONSTRAINT uq_vat_old_incomplete_ref_key
      DO UPDATE SET check_no = EXCLUDED.check_no, payment_date_old = EXCLUDED.payment_date_old, imported_at = now()
      RETURNING bu
      `,
      [input.bu, input.invoiceRef, input.supplierCode, input.expAmount, input.expVat, input.checkNo, input.paymentDateOld]
    );
    const distinctBus = [...new Set(saved.map((r) => r.bu))];
    if (distinctBus.length > 0) {
      await applyOldIncompleteRefJoin(client, distinctBus);
    }
    await client.query("COMMIT");
    res.json({ success: true, matchedCount: input.bu.length, directMatchCount, savedCount: saved.length });
  } catch (err) {
    await client.query("ROLLBACK");
    console.error("vat_watchlist_old_incomplete_ref confirm_save error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  } finally {
    client.release();
  }
});

// MARKER_VATWATCHLISTOPS_OLDREF_LOOKUP_BY_CHECKS_V1
// -- POST /api/vat_watchlist_old_incomplete_ref/lookup_by_checks --
// -- Read-only: รับ [{bu, check_no}, ...] หลายคู่ในคำขอเดียว คืนทุกแถวใน vat_watchlist_old_incomplete_ref --
// -- ที่ตรงกับคู่ไหนก็ได้ (รวมใบที่จ่ายจบไปแล้ว ไม่ได้อยู่ใน Incomplete ปัจจุบันด้วย) --
// -- ใช้โดย Check Return Matching Tier 1.5: เช็คยอดกับ "กลุ่มเต็ม" ของเช็คเดิม เผื่อบางใบจ่ายจบไปแล้วทำให้ยอด --
// -- จากแค่ใบที่เหลือ Incomplete ไม่ครบ --
app.post("/api/vat_watchlist_old_incomplete_ref/lookup_by_checks", checkPermission("vat_watchlist_report", "write"), async (req, res) => {
  const { pairs } = req.body || {};
  if (!Array.isArray(pairs) || pairs.length === 0) {
    return res.json({ success: true, rows: [] });
  }
  const bu = [], checkNo = [];
  const seen = new Set();
  for (const p of pairs) {
    if (!p || !p.bu || !p.check_no) continue;
    const key = `${p.bu}|||${p.check_no}`;
    if (seen.has(key)) continue; // MARKER_VATWATCHLISTOPS_OLDREF_LOOKUP_BY_CHECKS_V1 -- กัน Pair ซ้ำ ไม่ต้องส่งเข้า UNNEST ซ้ำ
    seen.add(key);
    bu.push(p.bu);
    checkNo.push(p.check_no);
  }
  if (bu.length === 0) {
    return res.json({ success: true, rows: [] });
  }
  try {
    const { rows } = await pool.query(
      `
      SELECT DISTINCT ref.bu, ref.invoice_ref, ref.supplier_code, ref.exp_amount, ref.exp_vat, ref.check_no, ref.payment_date_old
      FROM UNNEST($1::text[], $2::text[]) AS pair(bu, check_no)
      JOIN vat_watchlist_old_incomplete_ref ref
        ON ref.bu = pair.bu AND ref.check_no = pair.check_no
      `,
      [bu, checkNo]
    );
    res.json({ success: true, rows });
  } catch (err) {
    console.error("vat_watchlist_old_incomplete_ref lookup_by_checks error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  }
});
// MARKER_APP_VAT_BACKUP_TAX_INVOICE_PURGE_V1
// -- POST /api/vat_backup_tax_invoice/purge -- ล้างข้อมูลหน้า Tax Invoice (เฉพาะ Owner) -- ต้องอยู่ก่อน Generic Mount --
// -- action: 'options' (นับแยก Source/Status/BU ทั้งตาราง) | 'preview' (นับตามเงื่อนไข) | 'delete' (ลบจริง ต้องส่ง expected_count ตรงกับที่นับสดตอนลบ) --
// -- เงื่อนไข (AND กัน): source_type, status, bu, date_from/date_to (doc_date), older_than_months (doc_date < วันนี้ - N เดือน), all=true (ไม่กรอง ต้องส่งชัดเจน) --
app.post("/api/vat_backup_tax_invoice/purge", async (req, res) => {
  if (req.user?.appRole !== "Owner") {
    return res.status(403).json({ error: "เฉพาะ Owner เท่านั้น" });
  }
  const body = req.body || {};
  const action = body.action || "preview";
  const docDateExpr = "NULLIF(doc_date::text, '')::date";
  try {
    if (action === "options") {
      const [bySource, byStatus, byBu, range] = await Promise.all([
        pool.query("SELECT COALESCE(source_type, '') AS k, COUNT(*)::int AS n FROM vat_backup_tax_invoice GROUP BY 1 ORDER BY n DESC"),
        pool.query("SELECT COALESCE(status, '') AS k, COUNT(*)::int AS n FROM vat_backup_tax_invoice GROUP BY 1 ORDER BY n DESC"),
        pool.query("SELECT COALESCE(bu, '') AS k, COUNT(*)::int AS n FROM vat_backup_tax_invoice GROUP BY 1 ORDER BY k"),
        pool.query("SELECT MIN(" + docDateExpr + ") AS min_date, MAX(" + docDateExpr + ") AS max_date, COUNT(*)::int AS total FROM vat_backup_tax_invoice"),
      ]);
      return res.json({ by_source: bySource.rows, by_status: byStatus.rows, by_bu: byBu.rows, min_date: range.rows[0].min_date, max_date: range.rows[0].max_date, total: range.rows[0].total });
    }

    const conds = [];
    const vals = [];
    const add = (sql, v) => { vals.push(v); conds.push(sql.replace("?", "$" + vals.length)); };
    if (body.source_type) add("COALESCE(source_type, '') = ?", String(body.source_type) === "__blank__" ? "" : String(body.source_type));
    if (body.status) add("COALESCE(status, '') = ?", String(body.status) === "__blank__" ? "" : String(body.status));
    if (body.bu) add("bu = ?", String(body.bu));
    if (body.date_from) add(docDateExpr + " >= ?::date", String(body.date_from));
    if (body.date_to) add(docDateExpr + " <= ?::date", String(body.date_to));
    if (body.older_than_months !== undefined && body.older_than_months !== null && body.older_than_months !== "") {
      const months = Number(body.older_than_months);
      if (!Number.isInteger(months) || months < 1 || months > 120) {
        return res.status(400).json({ error: "older_than_months ต้องเป็นจำนวนเต็ม 1-120" });
      }
      conds.push(docDateExpr + " < (CURRENT_DATE - (" + months + " * INTERVAL '1 month'))::date");
    }
    if (conds.length === 0 && body.all !== true) {
      return res.status(400).json({ error: "ไม่ได้ระบุเงื่อนไข -- ถ้าต้องการล้างทั้งหมดต้องส่ง all=true" });
    }
    const where = conds.length ? "WHERE " + conds.join(" AND ") : "";

    const cnt = await pool.query("SELECT COUNT(*)::int AS n FROM vat_backup_tax_invoice " + where, vals);
    const count = cnt.rows[0].n;
    if (action === "preview") {
      return res.json({ count });
    }
    if (action !== "delete") {
      return res.status(400).json({ error: "action ไม่ถูกต้อง" });
    }
    if (Number(body.expected_count) !== count) {
      return res.status(409).json({ error: "จำนวนที่จะลบไม่ตรงกับที่ Preview ไว้ (ข้อมูลมีการเปลี่ยนแปลง) กรุณา Preview ใหม่", count });
    }
    const del = await pool.query("DELETE FROM vat_backup_tax_invoice " + where, vals);
    const filterDesc = JSON.stringify({ source_type: body.source_type || null, status: body.status || null, bu: body.bu || null, date_from: body.date_from || null, date_to: body.date_to || null, older_than_months: body.older_than_months || null, all: body.all === true });
    pool.query(
      "INSERT INTO activity_log (username, user_email, action, module, created_at) VALUES ($1, $2, $3, 'VAT_TAX_INVOICE', NOW())",
      [req.user?.username || null, req.user?.email || null, "PURGE_TAX_INVOICE deleted=" + del.rowCount + " filter=" + filterDesc]
    ).catch((e) => console.error("[purge tax invoice] activity_log error:", e.message));
    return res.json({ deleted: del.rowCount });
  } catch (err) {
    console.error("vat_backup_tax_invoice purge error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  }
});
// MARKER_APP_VAT_WATCHLIST_SYNC_DRAFT_STATUS_V1
// -- POST /api/vat_watchlist_report/sync_draft_status -- Sync สถานะ Report <-> Popvat Draft (Bidirectional) --
// -- ต้องอยู่ก่อน Generic Mount เหมือน replace_bu ด้านบน --
app.post("/api/vat_watchlist_report/sync_draft_status", checkPermission("vat_watchlist_report", "write"), async (req, res) => {
  const { bu } = req.body || {};
  if (!bu) {
    return res.status(400).json({ error: "bu is required" });
  }
  try {
    const toDraft = await pool.query(
      `UPDATE vat_watchlist_report r
       SET status = 'draft'
       FROM vat_upload_popvatdraft p
       WHERE r.bu = p.bu
         AND r.invoice_ref = p.original_invoice_number
         AND p.status = 'draft'
         AND (p.supplier_name IS NULL OR btrim(p.supplier_name) = '' OR left(btrim(COALESCE(r.vendor_name, '')), length(btrim(p.supplier_name))) = btrim(p.supplier_name) OR left(btrim(p.supplier_name), length(btrim(COALESCE(r.vendor_name, '')))) = btrim(COALESCE(r.vendor_name, ''))) -- MARKER_APP_SYNC_DRAFT_MATCH_SUPPLIER_V1 -- ต้อง Match BU + Invoice Ref + Supplier (ชื่อผู้ค้า ขึ้นต้นตรงกันได้ รองรับชื่อที่เคยมีข้อความ Total ต่อท้าย) ไม่ใช่แค่ Invoice Ref (Draft เก่าที่ supplier_name ว่างยังใช้ Invoice Ref อย่างเดียวเหมือนเดิม)
         AND r.status != 'draft'
         AND r.bu = $1
       RETURNING r.id`,
      [bu]
    );
    const toPending = await pool.query(
      `UPDATE vat_watchlist_report r
       SET status = 'pending'
       WHERE r.status = 'draft'
         AND r.bu = $1
         AND NOT EXISTS (
           SELECT 1 FROM vat_upload_popvatdraft p
           WHERE p.bu = r.bu AND p.original_invoice_number = r.invoice_ref
             AND (p.supplier_name IS NULL OR btrim(p.supplier_name) = '' OR left(btrim(COALESCE(r.vendor_name, '')), length(btrim(p.supplier_name))) = btrim(p.supplier_name) OR left(btrim(p.supplier_name), length(btrim(COALESCE(r.vendor_name, '')))) = btrim(COALESCE(r.vendor_name, ''))) -- MARKER_APP_SYNC_DRAFT_MATCH_SUPPLIER_V1
             AND p.status IN ('draft', 'exported', 'pv-backup') -- MARKER_APP_SYNC_DRAFT_KEEP_EXPORTED_V1 -- Generate File แล้ว (exported/pv-backup) ห้ามย้อนกลับเป็น pending
         )
       RETURNING r.id`,
      [bu]
    );
    // MARKER_APP_SYNC_AGING_ACCEPT_CONDITION_V1
    // -- Note Accept with Condition -> Aging = 'Accept' ทันที (ทิศทางเดียว Note -> Report เท่านั้น) --
    const toAccept = await pool.query(
      `UPDATE vat_watchlist_report r
       SET aging_months = NULL, aging_label = 'Accept'
       FROM vat_watchlist_notes n
       WHERE r.bu = n.bu
         AND r.invoice_ref = n.invoice_ref
         AND r.supplier_code = n.supplier_code
         AND n.status = 'accept_with_condition'
         AND r.aging_label != 'Accept'
         AND r.bu = $1
       RETURNING r.id`,
      [bu]
    );
    res.json({ success: true, to_draft: toDraft.rowCount, to_pending: toPending.rowCount, to_accept: toAccept.rowCount });
  } catch (err) {
    console.error("vat_watchlist_report sync_draft_status error:", err);
    res.status(500).json({ error: "Internal server error", detail: err.message });
  }
});
