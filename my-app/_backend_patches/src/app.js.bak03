// -- POST /api/internal/broadcast -- public เหมือนกัน (ไม่ผ่าน verifyAuthLocal)
// เพราะเป็น internal service เรียกเอง (เช่น ocr_worker_v2.py คนละ process/ภาษา
// ไม่มี user session/login token) ต้องอยู่ก่อน global auth middleware ด้านล่าง
// ไม่งั้นจะโดน verifyAuthLocal บังคับ auth ไปด้วยทั้งที่ route ไม่ได้เรียกเอง
// ความปลอดภัย: จำกัดเฉพาะ request จาก localhost เท่านั้น
app.post("/api/internal/broadcast", (req, res) => {
  const ip = req.ip || req.connection?.remoteAddress || "";
  const isLocalhost = ip === "127.0.0.1" || ip === "::1" || ip === "::ffff:127.0.0.1";
  if (!isLocalhost) {
    return res.status(403).json({ error: "internal endpoint only" });
  }
  const { event, ...data } = req.body;
  if (!event) return res.status(400).json({ error: "event required" });
  wsBroadcast(event, data);
  res.json({ ok: true });
});

