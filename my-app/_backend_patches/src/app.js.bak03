// MARKER_APP_BATCH_RECYCLE_BUNDLE_V1
// -- POST /api/batch-recycle-bundle � ??? batch_list + bucket_list (Invoice --
// -- ?????????????) ???? Recycle Bin ??????????? (1 Batch = 1 ?????? ?????? --
// -- ??????? Invoice) � ??????????????????????????? My Jobs � ???????????? --
// -- ??? ??? Log ???? recycle_bin ???????? ???? Frontend ????????????????? --
// -- ?hard=true (???? Soft Delete ???? ??? Insert ???) ---------------------
app.post("/api/batch-recycle-bundle", verifyAuthLocal, async (req, res, next) => {
  try {
    const { batch_id } = req.body;
    if (!batch_id) return res.status(400).json({ error: "batch_id required" });

    const { rows: batchRows } = await pool.query(
      `SELECT * FROM batch_list WHERE batch_id = $1`,
      [batch_id]
    );
    if (!batchRows[0]) return res.status(404).json({ error: "????? Batch ???" });

    const { rows: invoiceRows } = await pool.query(
      `SELECT * FROM bucket_list WHERE batch_id = $1`,
      [batch_id]
    );

    // ??? username ???????? (??? attachRole.js patch66) Fallback ???? email
    const deletedBy = req.user?.username || req.user?.email || "unknown";
    const bundledData = { batch: batchRows[0], invoices: invoiceRows };

    await pool.query(
      `INSERT INTO recycle_bin (source_table, source_id, source_key, data, deleted_by, deleted_at)
       VALUES ('batch_list', $1, $2, $3, $4, NOW())`,
      [batchRows[0].id, batch_id, JSON.stringify(bundledData), deletedBy]
    );

    res.json({ ok: true, invoiceCount: invoiceRows.length });
  } catch (err) {
    next(err);
  }
});

