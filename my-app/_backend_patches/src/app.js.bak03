// MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13
// -- Endpoint สำหรับ Popup "Transaction Dashboard" ใน System Console > Users --
// -- เปิดจาก UserManagement.js เมื่อกดชื่อ User ที่มี Permission Manual/IE ------
// -- Query สดจาก bucket_list ตรงๆ ไม่มีการเก็บ Summary ซ้ำในตารางใหม่ ----------
// MARKER_APP_USER_TRANSACTIONS_DASHBOARD_PERROW_FILLSTARTED_CORRECTION_V15
// -- เช็คทีละแถวแทนการเหมาบวก 7 ชม.ทั้งหมด เพราะข้อมูลจริงพิสูจน์แล้วว่าบาง --
// -- แถว fill_started_at ถูกเก็บถูกต้องอยู่แล้ว (ไม่ต้องบวก) ปนอยู่กับแถวที่ --
// -- ต้องบวก 7 ชม. (มาจาก Frontend คนละเวอร์ชัน) -- เลือกแบบที่ Gap เทียบกับ --
// -- created_at สมเหตุผล (0-4 ชม.) ถ้าไม่มีแบบไหนสมเหตุผลเลย Fallback เป็น --
// -- created_at (ปลอดภัยไว้ก่อน) --
const UTD_FILL_CORRECTED_COL = `
  CASE
    WHEN fill_started_at IS NULL THEN created_at AT TIME ZONE 'Asia/Bangkok'
    WHEN (created_at AT TIME ZONE 'Asia/Bangkok') - (fill_started_at AT TIME ZONE 'UTC' AT TIME ZONE 'Asia/Bangkok')
         BETWEEN INTERVAL '0 seconds' AND INTERVAL '4 hours'
      THEN (fill_started_at AT TIME ZONE 'UTC' AT TIME ZONE 'Asia/Bangkok')
    WHEN (created_at AT TIME ZONE 'Asia/Bangkok') - fill_started_at
         BETWEEN INTERVAL '0 seconds' AND INTERVAL '4 hours'
      THEN fill_started_at
    ELSE created_at AT TIME ZONE 'Asia/Bangkok'
  END
`;
const UTD_TS_COL     = UTD_FILL_CORRECTED_COL;
const UTD_MODULE_COL = "module";
const UTD_GROUP_COL  = "regexp_replace(regexp_replace(COALESCE(NULLIF(invoice_no, ''), local_id), '_NV$', '', 'i'), '/[0-9]+$', '')";
const UTD_MODULES    = ["AP", "IE", "COL-AP", "VAT"]; // MARKER_APP_USER_TRANSACTIONS_DASHBOARD_DOCCOLLECTION_COLAP_UNION_V2 (COALESCE confirmed_at/completed_at) -- เพิ่ม COL-AP (Query ตรงจาก doc_collection, ไม่ Shadow-Insert)
                                                       // MARKER_APP_USER_TRANSACTIONS_DASHBOARD_VAT_DRAFTID_UNION_V2 -- เพิ่ม VAT (Popvat/Simple/ADI, Group ตาม draft_id)
const UTD_AFTERHOURS_HOUR    = 18; // MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13 -- ส่งมาเฉยๆ เผื่อใช้งานอื่น ไม่มีผลกับ Gap อีกต่อไป (Frontend เลิก Highlight ด้วย Flag นี้แล้ว)
const UTD_WORKDAY_START_HOUR = 8;  // MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13 -- ช่วงเวลาทำงานที่ใช้คิด Gap: 08:00-19:00 (ยืนยันจาก User: "เริ่มนับ Gap ตั้งแต่ 8 โมง ถึง 1 ทุ่ม")
const UTD_WORKDAY_END_HOUR   = 19;

app.get("/api/user_transactions/dashboard", async (req, res) => {
  try {
    const { username, from, to, granularity } = req.query;
    if (!username || !from || !to) {
      return res.status(400).json({ error: "ต้องระบุ username, from, to" });
    }
    const gran = ["daily", "weekly", "monthly"].includes(granularity) ? granularity : "daily";
    const toExclusive = `${to} 23:59:59.999`;

    const baseSql = `
      WITH raw AS (
        SELECT
          ${UTD_GROUP_COL} AS grp_key,
          ${UTD_MODULE_COL} AS module,
          ${UTD_TS_COL} AS ts_real,
          ${UTD_FILL_CORRECTED_COL} AS fill_bkk, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_PERROW_FILLSTARTED_CORRECTION_V15 */
          created_at AT TIME ZONE 'Asia/Bangkok' AS created_bkk,
          CASE WHEN jsonb_typeof(lines) = 'array' THEN jsonb_array_length(lines) ELSE 1 END AS line_count,
          fill_started_at IS NOT NULL AS has_fill_flag, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_HAS_FILL_START_FLAG_V17 */
          bu,
          invoice_no,
          batch_id,
          vendor_name
        FROM bucket_list
        WHERE created_by = $1
          AND ${UTD_MODULE_COL} = ANY($4::text[])
          AND ${UTD_TS_COL} >= ($2::date - INTERVAL '2 days')
          AND ${UTD_TS_COL} <= $3::timestamp

        UNION ALL

        -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_DOCCOLLECTION_COLAP_UNION_V1 -- COL-AP: Query ตรงจาก doc_collection (Cross Check Confirm แล้วเท่านั้น) ไม่ Shadow-Insert ซ้ำเข้า bucket_list
        SELECT
          serial_code AS grp_key,
          'COL-AP' AS module,
          ((COALESCE(NULLIF(cross_check->>'confirmed_at',''), cross_check->>'completed_at'))::timestamptz AT TIME ZONE 'Asia/Bangkok') AS ts_real,
          (fill_started_at AT TIME ZONE 'Asia/Bangkok') AS fill_bkk,
          ((COALESCE(NULLIF(cross_check->>'confirmed_at',''), cross_check->>'completed_at'))::timestamptz AT TIME ZONE 'Asia/Bangkok') AS created_bkk,
          (CASE WHEN jsonb_typeof(rows) = 'array' THEN jsonb_array_length(rows) ELSE 1 END) AS line_count,
          (fill_started_at IS NOT NULL) AS has_fill_flag,
          bu_code AS bu, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_COLAP_BU_INVOICE_FIX_V1 -- เดิมใช้ bu_code_name (Label "รหัส - ชื่อบริษัท" เช่น "5898 - Miracle Planet Co., Ltd.") ผิด ไม่ใช่ BU Code จริง -- เปลี่ยนเป็น bu_code ตรงๆ */
          (CASE WHEN jsonb_typeof(rows) = 'array' THEN (
             SELECT NULLIF(string_agg(DISTINCT v.val, ', '), '')
             FROM jsonb_array_elements(rows) elem
             CROSS JOIN LATERAL (
               SELECT COALESCE(
                 NULLIF(elem->>'Invoice Number', ''),
                 NULLIF(elem->>'Invoice Num', ''),
                 NULLIF(elem->>'Tax Invoice No.', '')
               ) AS val
             ) v
             WHERE v.val IS NOT NULL
           ) ELSE NULL END) AS invoice_no, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_COLAP_INVOICE_FROM_ROWS_V1 -- ดึงเลข Invoice จริงจากระดับบรรทัดใน rows (Invoice Number/Invoice Num สำหรับ APN01, Tax Invoice No. สำหรับ AP09) รวมเป็น List คั่น ", " ถ้ามีหลายเลขใน Batch เดียวกัน (ไม่ Duplicate ค่าเดิมซ้ำ) */
          serial_code AS batch_id, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_COLAP_BU_INVOICE_FIX_V1 */
          NULL::text AS vendor_name
        FROM doc_collection
        WHERE uploaded_by = $1
          AND doc_type IN ('APN01', 'AP09', 'AP07')
          AND (cross_check->>'confirmed')::boolean IS TRUE
          AND 'COL-AP' = ANY($4::text[])
          AND ((COALESCE(NULLIF(cross_check->>'confirmed_at',''), cross_check->>'completed_at'))::timestamptz AT TIME ZONE 'Asia/Bangkok') >= ($2::date - INTERVAL '2 days')
          AND ((COALESCE(NULLIF(cross_check->>'confirmed_at',''), cross_check->>'completed_at'))::timestamptz AT TIME ZONE 'Asia/Bangkok') <= $3::timestamp

        UNION ALL

        -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_VAT_DRAFTID_UNION_V2 -- VAT (Popvat/Simple/ADI): Group ตาม Draft_id เดียวกัน (ไม่ใช่ Invoice เพราะ 1 Draft มีได้หลาย Invoice/หลายบรรทัด) -- รวม 3 Table เป็น Transaction เดียวถ้า Draft_id ตรงกัน
        SELECT
          draft_id::text AS grp_key,
          'VAT' AS module,
          ${UTD_FILL_CORRECTED_COL} AS ts_real,
          ${UTD_FILL_CORRECTED_COL} AS fill_bkk,
          created_at AT TIME ZONE 'Asia/Bangkok' AS created_bkk,
          line_count, /* MARKER_APP_USER_TRANSACTIONS_VAT_ARCHIVE_UNION_V1 -- ปกติ 1 ต่อแถว แต่แถว Archive (Draft ที่ลบหลังครบ 6 เดือน) เก็บยอดรวมไว้ในนี้ */
          fill_started_at IS NOT NULL AS has_fill_flag,
          bu::text AS bu,
          draft_id::text AS invoice_no,
          batch_id::text AS batch_id,
          NULL::text AS vendor_name
        FROM (
          SELECT draft_id, username, bu, fill_started_at, created_at, batch_id, 1 AS line_count FROM vat_upload_popvatdraft
          UNION ALL
          SELECT draft_id, username, bu, fill_started_at, created_at, batch_id, 1 AS line_count FROM vat_simpleinputdraft
          UNION ALL
          SELECT draft_id, username, bu, fill_started_at, created_at, batch_id, 1 AS line_count FROM vat_adi_transferdraft
          UNION ALL
          SELECT draft_id, username, bu, fill_started_at, created_at, batch_id, line_count FROM vat_transaction_archive
        ) vat_all
        WHERE username = $1
          AND draft_id IS NOT NULL AND draft_id <> ''
          AND 'VAT' = ANY($4::text[])
          AND ${UTD_FILL_CORRECTED_COL} >= ($2::date - INTERVAL '2 days')
          AND ${UTD_FILL_CORRECTED_COL} <= $3::timestamp
      ),
      per_invoice AS (
        SELECT
          grp_key, MIN(module) AS module, MIN(ts_real) AS ts_real,
          SUM(line_count) AS sub_items,
          MIN(fill_bkk) AS work_start_raw, MAX(created_bkk) AS work_end,
          bool_or(has_fill_flag) AS has_fill_start, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_HAS_FILL_START_FLAG_V17 */
          MIN(bu) AS bu, MIN(invoice_no) AS invoice_no, MIN(batch_id) AS batch_id, MIN(vendor_name) AS vendor_name
        FROM raw
        GROUP BY grp_key
      ),
      adj AS (
        SELECT
          grp_key, module, sub_items, bu, invoice_no, batch_id, vendor_name,
          has_fill_start, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_HAS_FILL_START_FLAG_V17 */
          ts_real,
          ts_real AS ts,
          COALESCE(work_start_raw, ts_real) AS start_ts, -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_START_END_TIME_V14 -- เวลาเริ่มกรอก (fill_started_at) ถ้าไม่มี Fallback เป็น ts_real
          work_end AS end_ts, -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_START_END_TIME_V14 -- เวลา Submit จริง (created_at)
          (EXTRACT(HOUR FROM ts_real) >= ${UTD_AFTERHOURS_HOUR}) AS is_after_hours,
          (EXTRACT(DOW FROM ts_real) IN (0, 6)) AS is_weekend_source, -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13 -- Transaction ที่ทำจริงในวันเสาร์(6)/อาทิตย์(0) เอาไว้ให้ Frontend โชว์บน Timeline เฉยๆ ไม่เอาไปคิด Gap
          (
            EXTRACT(HOUR FROM ts_real) >= ${UTD_WORKDAY_START_HOUR}
            AND EXTRACT(HOUR FROM ts_real) < ${UTD_WORKDAY_END_HOUR}
            AND NOT (EXTRACT(DOW FROM ts_real) IN (0, 6))
          ) AS is_gap_eligible, -- MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13 -- อยู่ในช่วงเวลาทำงาน (08:00-19:00) และไม่ใช่วันหยุด ถึงจะเอาไปคิด Gap ได้
          CASE EXTRACT(DOW FROM ts_real)
               WHEN 6 THEN (ts_real::date + 2)
               WHEN 0 THEN (ts_real::date + 1)
               ELSE ts_real::date END AS business_date,
          CASE
            WHEN work_end IS NOT NULL AND COALESCE(work_start_raw, ts_real) IS NOT NULL
                 AND work_end > COALESCE(work_start_raw, ts_real) AND sub_items > 0
            THEN ROUND((EXTRACT(EPOCH FROM (work_end - COALESCE(work_start_raw, ts_real))) / 60.0 / sub_items)::numeric, 1)
            ELSE NULL
          END AS per_trans_minutes
        FROM per_invoice
      )
    `;

    if (gran === "daily") {
      const { rows } = await pool.query(
        baseSql + `
        SELECT
          grp_key, module, ts, ts_real, start_ts, end_ts, has_fill_start, is_after_hours, is_weekend_source, sub_items, per_trans_minutes, bu, invoice_no, batch_id, vendor_name, /* MARKER_APP_USER_TRANSACTIONS_DASHBOARD_START_END_TIME_V14 MARKER_APP_USER_TRANSACTIONS_DASHBOARD_HAS_FILL_START_FLAG_V17 */
          CASE WHEN is_gap_eligible AND LAG(is_gap_eligible) OVER (ORDER BY ts)
               THEN EXTRACT(EPOCH FROM (ts - LAG(ts) OVER (ORDER BY ts))) / 60
               ELSE NULL END AS gap_minutes
        FROM adj
        WHERE business_date = $2::date
        ORDER BY ts ASC`,
        [username, from, toExclusive, UTD_MODULES]
      );
      const totalSubItems = rows.reduce((s, r) => s + Number(r.sub_items || 0), 0);
      const gapValues = rows.filter(r => r.gap_minutes != null).map(r => Number(r.gap_minutes)); // MARKER_APP_USER_TRANSACTIONS_DASHBOARD_WORKING_HOURS_GAP_V13 -- เฉลี่ยเฉพาะ Gap ที่นับจริง (อยู่ในช่วงเวลาทำงานต่อเนื่องกัน) ไม่หารด้วยจำนวนแถวทั้งหมด
      const summary = rows.length ? {
        start_time: rows[0].ts,
        end_time: rows[rows.length - 1].ts,
        count: totalSubItems,
        avg_gap_minutes: gapValues.length
          ? Math.round((gapValues.reduce((s, g) => s + g, 0) / gapValues.length) * 10) / 10
          : null,
      } : { start_time: null, end_time: null, count: 0, avg_gap_minutes: null };

      return res.json({ granularity: "daily", from, to, summary, transactions: rows });
    }

    const { rows } = await pool.query(
      baseSql + `
      SELECT business_date AS date, module, SUM(sub_items) AS count
      FROM adj
      WHERE business_date BETWEEN $2::date AND $3::date
      GROUP BY business_date, module
      ORDER BY business_date ASC`,
      [username, from, toExclusive, UTD_MODULES]
    );

    const byDate = {};
    for (const r of rows) {
      const d = r.date instanceof Date ? r.date.toISOString().slice(0, 10) : String(r.date).slice(0, 10);
      if (!byDate[d]) byDate[d] = { date: d, count: 0, modules: {} };
      byDate[d].count += Number(r.count);
      byDate[d].modules[r.module] = (byDate[d].modules[r.module] || 0) + Number(r.count);
    }
    const days = Object.values(byDate).sort((a, b) => a.date.localeCompare(b.date));
    const totalCount = days.reduce((s, d) => s + d.count, 0);
    const activeDays = days.filter(d => d.count > 0).length;

    return res.json({
      granularity: gran,
      from, to,
      summary: {
        total_count: totalCount,
        active_days: activeDays,
        avg_per_day: activeDays ? Math.round((totalCount / activeDays) * 10) / 10 : 0,
      },
      days,
    });
  } catch (err) {
    console.error("GET /api/user_transactions/dashboard error:", err.message);
    res.status(500).json({ error: "Internal server error" });
  }
});
